{
  "main": "dist/_worker.js/index.js",
  "name": "website-mares-cz",
  "compatibility_date": "2025-10-25", // Update to the day you deploy
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "STRAPI_API_URL": "https://cms.mareshq.com/api"
  },
  "logpush": true
}
