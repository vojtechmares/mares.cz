{
  "name": "website-mares-cz-v3",
  "compatibility_date": "2025-12-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "staging": {
      "name": "website-mares-cz-v3-staging",
      "routes": [{ "pattern": "beta.mares.cz", "custom_domain": true }],
    },
    "production": {
      "name": "website-mares-cz-v3-production",
      "routes": [{ "pattern": "www.mares.cz", "custom_domain": true }],
    },
  },
}
