---
import "../styles/global.css";

import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import Meta from "../components/seo/Meta.astro";
import Favicon from "../components/seo/Favicon.astro";
import Fediverse from "../components/seo/Fediverse.astro";
import Twitter from "../components/seo/Twitter.astro";
import OpenGraph from "../components/seo/OpenGraph.astro";
import { LocalizedMetadata } from "../lib/site";
import { strapi } from "../lib/strapi";
import GoogleAnalytics from "../components/analytics/GoogleAnalytics.astro";
import CookieConsent from "../components/layout/CookieConsent.astro";

interface Props {
  meta?: {
    title: string;
    description: string;
    keywords?: string;
    canonical?: string;
  };

  openGraph?: {
    type: "website" | "article";
    image: {
      url: string;
      width: number;
      height: number;
      alt: string;
    };
  };
}

const { meta, openGraph = undefined } = Astro.props;

let locale = Astro.currentLocale;
if (locale === undefined) {
  locale = "cs";
}

const metadataDefaults = LocalizedMetadata.filter(
  (m) => m.locale === locale,
)[0];

const pages = await strapi.fetchPages();
const trainings = await strapi.fetchTrainings();
---

<!doctype html>
<html
  lang="cs"
  class="h-full scroll-smooth bg-white antialiased [font-feature-settings:'ss01']"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Favicon />
    <Meta
      title={meta?.title ?? metadataDefaults.title}
      description={meta?.description ?? metadataDefaults.description}
      keywords={meta?.keywords}
    />
    <Twitter
      title={meta?.title ?? metadataDefaults.title}
      description={meta?.description ?? metadataDefaults.description}
      image={openGraph?.image}
    />
    <Fediverse />
    {
      openGraph !== undefined && (
        <OpenGraph
          type={openGraph.type}
          title={meta?.title ?? metadataDefaults.title}
          description={meta?.description ?? metadataDefaults.description}
          image={openGraph.image}
        />
      )
    }
    <link rel="preconnect" href="https://cdn.mares.cz" />
    <GoogleAnalytics />
  </head>
  <body class="flex h-full flex-col">
    <Navigation pages={pages} />
    <slot />
    <Footer pages={pages} trainings={trainings} />
    <CookieConsent />
  </body>
</html>
