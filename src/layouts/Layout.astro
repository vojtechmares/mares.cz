---
import "../styles/global.css";

import Navigation from "../features/layout/Navigation.astro";
import Footer from "../features/layout/Footer.astro";
import Meta from "../features/layout/seo/Meta.astro";
import Favicon from "../features/layout/seo/Favicon.astro";
import Fediverse from "../features/layout/seo/Fediverse.astro";
import Twitter from "../features/layout/seo/Twitter.astro";
import OpenGraph from "../features/layout/seo/OpenGraph.astro";
import JSONLD from "../features/layout/seo/JSONLD.astro";
import { LocalizedMetadata } from "../lib/site";
import GoogleAnalytics from "../features/analytics/GoogleAnalytics.astro";
import CookieConsent from "../features/layout/CookieConsent.astro";
import { t } from "../i18n";
import { localizeUrl } from "../i18n/routes";
import { englishPathToCzech } from "../i18n/routes";

interface Props {
  meta?: {
    title: string;
    description: string;
    keywords?: string;
    canonical?: string;
  };

  openGraph?: {
    type: "website" | "article";
    image: {
      url: string;
      width: number;
      height: number;
      alt: string;
    };
  };

  jsonLd?:
    | {
        type: "BlogPosting";
        headline: string;
        description: string;
        datePublished: string;
        dateModified: string;
        author: {
          name: string;
          url: string;
        };
        keywords: string;
        image?: string;
        url: string;
      }
    | {
        type: "WebSite" | "Organization" | "Person";
      }
    | {
        type: "CollectionPage";
        name: string;
        description: string;
        url: string;
      }
    | {
        type: "Course";
        name: string;
        description: string;
        provider: {
          name: string;
          url: string;
        };
        offers?: {
          price: number;
          priceCurrency: string;
        };
        hasCourseInstance?: {
          startDate: string;
          endDate?: string;
          courseMode: string;
          location: string;
        }[];
      }
    | {
        type: "ItemList";
        items: {
          name: string;
          startDate: string;
          endDate?: string;
          location: string;
          organizerName: string;
          organizerUrl: string;
          price: number;
          priceCurrency: string;
          offerUrl?: string;
        }[];
      };
}

const { meta, openGraph = undefined, jsonLd = undefined } = Astro.props;

const locale = Astro.locals.locale;
const lang = locale === "en" ? "en" : "cs";

const metadataDefaults = LocalizedMetadata.filter((m) => m.locale === locale)[0];

// Compute Czech path for hreflang (strip /en prefix and translate back)
const czechPath = locale === "en" ? englishPathToCzech(Astro.url.pathname) : Astro.url.pathname;
const csUrl = new URL(czechPath, Astro.site).toString();
const enUrl = new URL(localizeUrl(czechPath, "en"), Astro.site).toString();
---

<!doctype html>
<html lang={lang} class="h-full scroll-smooth bg-zinc-100 font-sans [font-feature-settings:'ss01'] antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang="cs" href={csUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={csUrl} />
    <Favicon />
    <Meta
      title={meta?.title ?? metadataDefaults.title}
      description={meta?.description ?? metadataDefaults.description}
      keywords={meta?.keywords}
    />
    <Twitter
      title={meta?.title ?? metadataDefaults.title}
      description={meta?.description ?? metadataDefaults.description}
      image={openGraph?.image}
    />
    <Fediverse />
    {
      openGraph !== undefined && (
        <OpenGraph
          type={openGraph.type}
          title={meta?.title ?? metadataDefaults.title}
          description={meta?.description ?? metadataDefaults.description}
          image={openGraph.image}
        />
      )
    }
    {jsonLd !== undefined && <JSONLD schema={jsonLd} locale={locale} />}
    <link rel="preconnect" href="https://cdn.mares.cz" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&display=swap"
      rel="stylesheet"
    />
    <GoogleAnalytics />
    <slot name="head" />
  </head>
  <body class="flex h-full flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-4 focus:text-zinc-900"
    >
      {t(locale, "layout.skip_to_content")}
    </a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body></html
>
