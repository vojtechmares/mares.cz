---
import "../styles/global.css";

import Navigation from "../features/layout/Navigation.astro";
import Footer from "../features/layout/Footer.astro";
import Meta from "../features/layout/seo/Meta.astro";
import Favicon from "../features/layout/seo/Favicon.astro";
import Fediverse from "../features/layout/seo/Fediverse.astro";
import Twitter from "../features/layout/seo/Twitter.astro";
import OpenGraph from "../features/layout/seo/OpenGraph.astro";
import JSONLD from "../features/layout/seo/JSONLD.astro";
import { LocalizedMetadata } from "../lib/site";
import GoogleAnalytics from "../features/analytics/GoogleAnalytics.astro";
import CookieConsent from "../features/layout/CookieConsent.astro";

interface Props {
  lang?: string;
  meta?: {
    title: string;
    description: string;
    keywords?: string;
    canonical?: string;
  };

  openGraph?: {
    type: "website" | "article";
    image: {
      url: string;
      width: number;
      height: number;
      alt: string;
    };
  };

  jsonLd?:
    | {
        type: "BlogPosting";
        headline: string;
        description: string;
        datePublished: string;
        dateModified: string;
        author: {
          name: string;
          url: string;
        };
        keywords: string;
        image?: string;
        url: string;
      }
    | {
        type: "WebSite" | "Organization" | "Person";
      }
    | {
        type: "CollectionPage";
        name: string;
        description: string;
        url: string;
        numberOfItems: number;
      }
    | {
        type: "Course";
        name: string;
        description: string;
        provider: {
          name: string;
          url: string;
        };
        offers?: {
          price: number;
          priceCurrency: string;
        };
        hasCourseInstance?: {
          startDate: string;
          endDate?: string;
          courseMode: string;
          location: string;
        }[];
      }
    | {
        type: "ItemList";
        items: {
          name: string;
          startDate: string;
          endDate?: string;
          location: string;
          organizerName: string;
          organizerUrl: string;
          price: number;
          priceCurrency: string;
          offerUrl?: string;
        }[];
      };
}

const {
  meta,
  openGraph = undefined,
  jsonLd = undefined,
  lang = "cs",
} = Astro.props;

let locale = Astro.currentLocale;
if (locale === undefined) {
  locale = "cs";
}

const metadataDefaults = LocalizedMetadata.filter(
  (m) => m.locale === locale,
)[0];
---

<!doctype html>
<html
  lang={lang}
  class="h-full scroll-smooth bg-zinc-100 font-mono antialiased [font-feature-settings:'ss01']"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Favicon />
    <Meta
      title={meta?.title ?? metadataDefaults.title}
      description={meta?.description ?? metadataDefaults.description}
      keywords={meta?.keywords}
    />
    <Twitter
      title={meta?.title ?? metadataDefaults.title}
      description={meta?.description ?? metadataDefaults.description}
      image={openGraph?.image}
    />
    <Fediverse />
    {
      openGraph !== undefined && (
        <OpenGraph
          type={openGraph.type}
          title={meta?.title ?? metadataDefaults.title}
          description={meta?.description ?? metadataDefaults.description}
          image={openGraph.image}
        />
      )
    }
    {jsonLd !== undefined && <JSONLD schema={jsonLd} />}
    <link rel="preconnect" href="https://cdn.mares.cz" />
    <GoogleAnalytics />
    <slot name="head" />
  </head>
  <body class="flex h-full flex-col">
    <Navigation />
    <slot />
    <Footer />
    <CookieConsent />
  </body>
</html>
