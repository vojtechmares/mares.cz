---
import type { Page } from "../interfaces/page";
import { Navigation as Navbar } from "./navigation";
import { LocalizedStaticNavigationLinks } from "../lib/site";

interface Props {
  pages: Page[];
}

let locale = Astro.currentLocale;
if (locale === undefined) {
  locale = "cs";
}

const staticLinks = LocalizedStaticNavigationLinks.filter((links) => {
  return links.locale === locale;
})[0].links;

const { pages } = Astro.props;

const pageLinks = pages
  .map((page) => {
    if (!page.featured) {
      return;
    }

    return { name: page.title, href: `/${page.slug}` };
  })
  .filter((link) => {
    return link !== undefined;
  });

const links = [
  ...(staticLinks as { name: string; href: string }[]),
  ...pageLinks,
];

// const links = [
//     {name: "Školení", href: "/skoleni"},
//     {name: "Termíny školení", href: "/terminy-skoleni"},
//     {name: "Služby", href: "#services"},
//     {name: "Blog", href: "/blog"},
//     {name: "Přednášky", href: "/prednasky"},
// ];
---

<Navbar links={links} />
