---
import {LocalizedMetadata} from "../../lib/site";

interface Props {
    title?: string;
    prefixedTitle?: string;
    description?: string;
    keywords?: string;
    canonical?: string;
}

let {
    title = undefined,
    prefixedTitle = undefined,
    description = undefined,
    keywords = undefined,
    canonical = undefined,
} = Astro.props;

let locale = Astro.currentLocale;
if (locale === undefined) {
    locale = "cs";
}

const metadata = LocalizedMetadata.filter((m) => m.locale === locale)[0];

if (title === undefined) {
    title = metadata.title;
}

if (description === undefined) {
    description = metadata.description;
}

if (keywords === undefined) {
    keywords = metadata.keywords;
}
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="Vojtěch Mareš" />
<meta name="theme-color" content="#ffffff" />
<meta name="canonical" content={
    canonical !== undefined ? canonical : Astro.url.toString()
}
