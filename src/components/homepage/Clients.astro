---
import { Image } from "astro:assets";

import { Section } from "../ui/section";
import { Heading } from "../ui/heading";
import { Container } from "../ui/container";

import logoGLAMI from "../../images/logos/glami.svg";
import logoFakturoid from "../../images/logos/fakturoid.svg";
import logoCybroslabs from "../../images/logos/cybroslabs-black.jpeg";
import logoNUMOTEQ from "../../images/logos/numoteq.png";
import logoNOTINO from "../../images/logos/notino.svg";
import logoPartners from "../../images/logos/partners.png";
import clsx from "clsx";

type Client = {
  name: string;
  logo: any;
};

const clients: Client[] = [
  { name: "GLAMI", logo: logoGLAMI },
  { name: "Fakturoid", logo: logoFakturoid },
  { name: "Cybros Labs", logo: logoCybroslabs },
  { name: "NUMOTEQ", logo: logoNUMOTEQ },
  { name: "NOTINO", logo: logoNOTINO },
  { name: "Partners", logo: logoPartners },
];
---

<Section id="clients" ariaLabel="Moji klienti" background="white">
  <Container>
    <Heading level="h2" className="md:text-center"> Moji klienti </Heading>
    <p class="mt-4 text-lg tracking-tight text-zinc-700 md:text-center">
      Společnosti, které mi důvěřují a se kterými mám tu čest dlouhodobě
      spolupracovat.
    </p>
    <div
      class="mx-auto mt-10 grid max-w-lg grid-cols-2 items-center gap-x-8 gap-y-10 sm:max-w-xl sm:grid-cols-3 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-3"
    >
      {
        clients.map((client) => (
          <Image
            alt={client.name}
            src={client.logo}
            width={165}
            height={96}
            class="col-span-2 h-24 w-full object-contain lg:col-span-1"
            loading={"lazy"}
            decoding={"async"}
          />
        ))
      }
    </div>
  </Container>
</Section>
