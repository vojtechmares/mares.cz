---
import {Button} from "../ui/button";
import {Heading} from "../ui/heading";
import {CallToAction as CTA} from "../landing/call-to-action";
---

<CTA id="pojdme-do-toho">
  <div class="mx-auto max-w-xl text-center">
    <Heading level="h2" text="black"> Pojďme do toho společně </Heading>
    <p class="mt-4 text-lg tracking-tight text-zinc-900">
      Nastal čas posunout vaši infrastrukturu na úroveň současných standardů.
      Infrastruktura má vaši aplikaci představit světu, nikoli ji držet zpátky.
    </p>
    <Button
      href="https://cal.com/vojtechmares/30min"
      color="black"
      size="large"
      className="mt-10"
    >
      Domluvme si schůzku
    </Button>
  </div>
</CTA>
