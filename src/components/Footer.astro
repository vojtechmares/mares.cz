---
import { Footer } from "./footer";
import type { Page } from "../interfaces/page";
import type { Training } from "../interfaces/training";
import { LocalizedStaticNavigationLinks } from "../lib/site";

interface Props {
  pages: Page[];
  trainings: Training[];
}

let locale = Astro.currentLocale;
if (locale === undefined) {
  locale = "cs";
}

const staticLinks = LocalizedStaticNavigationLinks.filter((links) => {
  return links.locale === locale;
})[0].links as { name: string; href: string }[];

const { pages, trainings } = Astro.props;
---

<Footer
  pages={pages}
  trainings={trainings}
  staticLinks={staticLinks}
  currentYear={new Date().getFullYear()}
/>
