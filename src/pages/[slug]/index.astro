---
import {MarkdownContent} from "../../components/markdown-content";
import Layout from "../../layouts/Layout.astro";
import {dateToLastModified} from "../../lib/caching";
import {strapi} from "../../lib/strapi";

const {slug} = Astro.params;

if (slug === undefined) {
    return new Response(null, {status: 404});
}

const page = await strapi.getPage(slug);

Astro.response.headers.set("Cache-Control", "s-maxage=60, must-revalidate");

if (page.updatedAt !== null) {
    Astro.response.headers.set(
        "Last-Modified",
        dateToLastModified(page.updatedAt)
    );
}

const meta = {
    title: "Vojtěch Mareš | " + page.title,
    description: page.description,
    keywords: page.keywords,
};

const openGraph = {
    type: "website" as "website",
    image: {
        url: Astro.site + page.slug + "/card.png",
        width: 1200,
        height: 630,
        alt: page.title + ": " + page.description,
    },
};
---

<Layout meta={meta} openGraph={openGraph}>
    <article>
        <MarkdownContent content={page.content} />
    </article>
</Layout>
