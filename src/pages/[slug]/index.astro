---
import { MarkdownContent } from "../../components/markdown-content";
import { Container } from "../../components/ui/container";
import { Heading } from "../../components/ui/heading";
import { Section } from "../../components/ui/section";
import Layout from "../../layouts/Layout.astro";
import { strapi } from "../../lib/strapi";

const { slug } = Astro.params;

if (slug === undefined) {
  return new Response(null, { status: 404 });
}

const page = await strapi.getPage(slug);

const meta = {
  title: "Vojtěch Mareš | " + page.title,
  description: page.description,
  keywords: page.keywords,
};

const openGraph = {
  type: "website" as const,
  image: {
    url: Astro.site + page.slug + "/card.png",
    width: 1200,
    height: 630,
    alt: page.title + ": " + page.description,
  },
};
---

<Layout meta={meta} openGraph={openGraph}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse" level="h1">{page.title}</Heading>
    </Container>
  </Section>
  <Section>
    <article>
      <MarkdownContent content={page.content} />
    </article>
  </Section>
</Layout>
