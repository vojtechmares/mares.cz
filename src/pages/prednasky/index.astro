---
import { getCollection, render } from "astro:content";
import { Container } from "../../components/ui/container";
import { Heading } from "../../components/ui/heading";
import { Link } from "../../components/ui/link";
import { Section } from "../../components/ui/section";
import Layout from "../../layouts/Layout.astro";
import { Prose } from "../../components/prose";
import { CachePresets } from "../../lib/cache";
import { TalksHero } from "../../features/talks/talks-hero";

Astro.response.headers.set("Cache-Control", CachePresets.content);

const talks = (await getCollection("talk", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const talkCount = talks.length;
const eventCount = new Set(talks.map((t) => t.data.event.name)).size;
const yearsOfSpeaking = new Date().getFullYear() - Math.min(...talks.map((t) => t.data.date.getFullYear()));

// Pre-render all talk content
const renderedTalks = await Promise.all(
  talks.map(async (talk) => ({
    talk,
    Content: (await render(talk)).Content,
  })),
);

const meta = {
  title: "Vojtěch Mareš | Přednášky",
  description: "Přehled přednášek a workshopů, které jsem měl možnost dělat.",
  keywords: "přednášky, talks, workshop",
};

const openGraph = {
  type: "website" as const,
  image: {
    url: Astro.url + "/card.png",
    width: 1200,
    height: 630,
    alt: "Přednášky na konferencích",
  },
};
---

<Layout meta={meta} openGraph={openGraph}>
  <TalksHero talkCount={talkCount} eventCount={eventCount} yearsOfSpeaking={yearsOfSpeaking} />
  <Section>
    <Container mode="prose">
      {
        renderedTalks.map(({ talk, Content }) => (
          <article class="mb-12 last:mb-0">
            <Heading level="h2">{talk.data.title}</Heading>
            <p class="mt-4 text-zinc-600">
              {talk.data.date.toLocaleDateString("cs-CZ")}
              {" · "}
              {talk.data.event.url ? (
                <Link href={talk.data.event.url} external>
                  {talk.data.event.name}
                </Link>
              ) : (
                talk.data.event.name
              )}
            </p>
            <Prose className="mt-6">
              <Content />
            </Prose>
          </article>
        ))
      }
    </Container>
  </Section>
</Layout>
