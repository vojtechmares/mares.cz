---
import { render } from "astro:content";
import { Container } from "../../components/ui/container";
import { Heading } from "../../components/ui/heading";
import { Link } from "../../components/ui/link";
import { Section } from "../../components/ui/section";
import Layout from "../../layouts/Layout.astro";
import { Prose } from "../../components/prose";
import { TalksHero } from "../../features/talks/talks-hero";
import { t } from "../../i18n";
import { formatDate } from "../../i18n/formatting";
import { localizeUrl } from "../../i18n/routes";
import { getLocalizedCollection } from "../../lib/content";

const locale = Astro.locals.locale;

const talks = (await getLocalizedCollection("talk", locale, ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const talkCount = talks.length;
const eventCount = new Set(talks.map((t) => t.data.event.name)).size;
const yearsOfSpeaking = new Date().getFullYear() - Math.min(...talks.map((t) => t.data.date.getFullYear()));

// Pre-render all talk content
const renderedTalks = await Promise.all(
  talks.map(async (talk) => ({
    talk,
    Content: (await render(talk)).Content,
  })),
);

const meta = {
  title: t(locale, "talks.meta_title"),
  description: t(locale, "talks.meta_description"),
  keywords: t(locale, "talks.meta_keywords"),
};

const openGraph = {
  type: "website" as const,
  image: {
    url: new URL(localizeUrl("/prednasky", locale) + "/card.png", Astro.site).toString(),
    width: 1200,
    height: 630,
    alt: t(locale, "talks.og_alt"),
  },
};
---

<Layout meta={meta} openGraph={openGraph}>
  <TalksHero talkCount={talkCount} eventCount={eventCount} yearsOfSpeaking={yearsOfSpeaking} locale={locale} />
  <Section>
    <Container mode="prose">
      {
        renderedTalks.map(({ talk, Content }) => (
          <article class="mb-12 last:mb-0">
            <Heading level="h2">{talk.data.title}</Heading>
            <p class="mt-4 text-zinc-600">
              {formatDate(talk.data.date, locale, { day: "numeric", month: "numeric", year: "numeric" })}
              {" · "}
              {talk.data.event.url ? (
                <Link href={talk.data.event.url} external>
                  {talk.data.event.name}
                </Link>
              ) : (
                talk.data.event.name
              )}
            </p>
            <Prose className="mt-6">
              <Content />
            </Prose>
          </article>
        ))
      }
    </Container>
  </Section>
</Layout>
