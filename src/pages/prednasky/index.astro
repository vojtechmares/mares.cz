---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { t } from "../../i18n";
import { formatDate } from "../../i18n/formatting";
import { localizeUrl } from "../../i18n/routes";
import { getLocalizedCollection } from "../../lib/content";

const locale = Astro.locals.locale;

const talks = (await getLocalizedCollection("talk", locale, ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const talkCount = talks.length;
const eventCount = new Set(talks.map((t) => t.data.event.name)).size;
const yearsOfSpeaking = new Date().getFullYear() - Math.min(...talks.map((t) => t.data.date.getFullYear()));

// Pre-render all talk content
const renderedTalks = await Promise.all(
  talks.map(async (talk) => ({
    talk,
    Content: (await render(talk)).Content,
  })),
);

const meta = {
  title: t(locale, "talks.meta_title"),
  description: t(locale, "talks.meta_description"),
  keywords: t(locale, "talks.meta_keywords"),
};

const openGraph = {
  type: "website" as const,
  image: {
    url: new URL(localizeUrl("/prednasky", locale) + "/card.png", Astro.site).toString(),
    width: 1200,
    height: 630,
    alt: t(locale, "talks.og_alt"),
  },
};
---

<Layout meta={meta} openGraph={openGraph}>
  <section class="section section--first">
    <div class="wrap">
      <p class="eyebrow">// {t(locale, "talks.eyebrow")}</p>
      <h1 class="h-page">{t(locale, "talks_page.heading")}</h1>
      <p class="lead lead--wide">{t(locale, "talks.description")}</p>
      <p class="note" style="margin-top: 24px">
        {
          [
            `${t(locale, "talks.talk_count", { count: talkCount })} ${t(locale, "talks.talk_count_label")}`,
            `${t(locale, "talks.event_count", { count: eventCount })} ${t(locale, "talks.event_count_label")}`,
            `${t(locale, "talks.years_count", { count: yearsOfSpeaking })} ${t(locale, "talks.years_count_label")}`,
          ].join(" · ")
        }
      </p>
    </div>
  </section>

  <section class="section--last">
    <div class="wrap">
      <div class="rows">
        {
          renderedTalks.map(({ talk, Content }) => (
            <article class="row row--talk">
              <time class="row__meta" datetime={talk.data.date.toISOString().slice(0, 10)}>
                {talk.data.date.toISOString().slice(0, 10)}
              </time>
              <div>
                <h2 class="row__title">{talk.data.title}</h2>
                <p class="row__tag" style="margin-top: 4px">
                  {talk.data.event.url ? (
                    <a href={talk.data.event.url} target="_blank" rel="noreferrer" class="link">
                      {talk.data.event.name} ↗
                    </a>
                  ) : (
                    talk.data.event.name
                  )}
                </p>
                <div class="prose prose--compact" style="margin-top: 16px">
                  <Content />
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
