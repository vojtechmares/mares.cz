---
import { Container } from "../../components/ui/container";
import { Heading } from "../../components/ui/heading";
import { TrainingSessionsTable } from "../../features/training/training-sessions-table";
import Layout from "../../layouts/Layout.astro";

import { notion } from "../../lib/notion";
import { Section } from "../../components/ui/section";
import { Card } from "../../components/ui/card";
import { TrainingGrid } from "../../features/training/training-grid";

// out-out of static pre-rendering
export const prerender = false;

const sessions = await notion.GetFutureTrainingSessions();

const meta = {
  title: "Vojtěch Mareš | Veřejné termíny školení",
  description:
    "Vypsané veřejné termíny školení, na které se může přihlásit každý. A nebo pokud nechcete firemní školení, ale jen poslat například pár zaměstnanců...",
  keywords: "školení, termíny, devops školení, termín školení",
};
---

<Layout meta={meta}>
  <main>
    <Section variant="inverse">
      <Container>
        <Heading variant="inverse" level="h1">Veřejné termíny školení</Heading>
      </Container>
    </Section>
    <Section>
      <Container>
        <TrainingSessionsTable sessions={sessions} />
        <Card variant="surface" className="mt-12 sm:mt-18">
          <Heading level="h3" id="podminky">
            Podmínky veřejných termínů školení
          </Heading>
          <ul class="mt-6 list-disc pl-4">
            <li>
              Přihlášení na veřejný termín školení je závazné a zavazujete se k
              platbě.
            </li>
            <li>
              Minimální počet účastníků pro uskuteční školení je <strong
                >5</strong
              >.
            </li>
            <li>
              Maximální počet účastníků na termínu je <strong>12</strong>.
            </li>
            <li>
              Školení je potvrzeno <strong>týden</strong> předem, nebo zrušeno z důvodu
              nízké účasti.
            </li>
            <li>
              Při odhlášení <strong>min. týden předem</strong> vracím <strong
                >plnou částku</strong
              >.
            </li>
            <li>
              Při odhlášení <strong>méně jak týden předem</strong> vracím pouze
              <strong>50% z ceny školení</strong>.
            </li>
            <li>
              Nabízím slevu <strong>50% pro studenty denního studia</strong> při doložení
              platného dokladu (potvrzení o studiu).
            </li>
          </ul>
        </Card>
      </Container>
    </Section>
    <TrainingGrid />
  </main>
</Layout>
