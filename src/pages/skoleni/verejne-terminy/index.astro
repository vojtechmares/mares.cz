---
import { Container } from "../../../components/ui/container";
import { Heading } from "../../../components/ui/heading";
import { TrainingSessionsTable } from "../../../features/training/training-sessions-table";
import { SessionsHero } from "../../../features/training/sessions-hero";
import { TrainingNewsletterSignUp } from "../../../features/training/training-newsletter-signup";
import Layout from "../../../layouts/Layout.astro";

import {
  getFutureSessions,
  toTrainingSession,
  getTrainingIDToSlugMap,
  enrichSessionsWithSlugs,
  getSessionPrice,
} from "../../../lib/sessions";
import { Section } from "../../../components/ui/section";
import { Card } from "../../../components/ui/card";
import { TrainingGrid } from "../../../features/training/training-grid";
import { t } from "../../../i18n";
import { getCurrencyForLocale } from "../../../i18n/formatting";
import { localizeUrl } from "../../../i18n/routes";
import { getLocalizedCollection } from "../../../lib/content";

const locale = Astro.locals.locale;

const [sessionEntries, slugMap, allTrainings] = await Promise.all([
  getFutureSessions(),
  getTrainingIDToSlugMap(),
  getLocalizedCollection("training", locale),
]);

const descriptionMap = new Map<number, string>();
for (const tr of allTrainings) {
  if (tr.data.backofficeID > 0) {
    descriptionMap.set(tr.data.backofficeID, tr.data.description);
  }
}

const sessions = enrichSessionsWithSlugs(sessionEntries.map(toTrainingSession), slugMap).map((s) => ({
  ...s,
  trainingDescription: descriptionMap.get(s.trainingID),
}));

const meta = {
  title: t(locale, "sessions_page.meta_title"),
  description: t(locale, "sessions_page.meta_description"),
  keywords: t(locale, "sessions_page.meta_keywords"),
};

const trainings = allTrainings.filter(({ data }) => !data.draft);
const nextSession = sessions.length > 0 ? sessions[0] : null;

const openGraph = {
  type: "website" as const,
  image: {
    url: new URL(localizeUrl("/skoleni/verejne-terminy", locale) + "/card.png", Astro.site).toString(),
    width: 1200,
    height: 630,
    alt: t(locale, "sessions_page.og_alt"),
  },
};

// Generate Event schema for each training session
const jsonLd = {
  type: "ItemList" as const,
  items: sessions.map((session) => ({
    name: session.name,
    startDate: new Date(session.dates.start).toISOString(),
    ...(session.dates.end && {
      endDate: new Date(session.dates.end).toISOString(),
    }),
    location: session.location,
    organizerName: "Vojtěch Mareš",
    organizerUrl: new URL(localizeUrl("/", locale), Astro.site).toString().replace(/\/$/, ""),
    price: getSessionPrice(session.pricing, locale),
    priceCurrency: getCurrencyForLocale(locale),
    ...(session.signUpURL && {
      offerUrl: session.signUpURL,
    }),
    ...(session.trainingSlug && {
      url: new URL(localizeUrl(`/skoleni/${session.trainingSlug}`, locale), Astro.site).toString(),
    }),
  })),
};
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <SessionsHero
    sessionCount={sessions.length}
    topicCount={trainings.length}
    nextSessionDate={nextSession ? new Date(nextSession.dates.start).toISOString() : null}
    locale={locale}
  />
  <Section id="terminy">
    <Container>
      <TrainingSessionsTable sessions={sessions} locale={locale} />
      <div class="mt-12 grid grid-cols-1 gap-8 sm:mt-18 lg:grid-cols-2">
        <Card variant="surface">
          <Heading level="h3" id="podminky">{t(locale, "sessions_page.conditions_heading")}</Heading>
          <ul class="mt-6 list-disc pl-4">
            <li>{t(locale, "sessions_page.condition_binding")}</li>
            <li>
              {t(locale, "sessions_page.condition_min")}
              <strong>{t(locale, "sessions_page.condition_min_count")}</strong>.
            </li>
            <li>
              {t(locale, "sessions_page.condition_max")}
              <strong>{t(locale, "sessions_page.condition_max_count")}</strong>.
            </li>
            <li>
              {t(locale, "sessions_page.condition_confirmed")}
              <strong>{t(locale, "sessions_page.condition_confirmed_when")}</strong>
              {t(locale, "sessions_page.condition_confirmed_suffix")}
            </li>
            <li>
              {t(locale, "sessions_page.condition_cancel_early")}
              <strong>{t(locale, "sessions_page.condition_cancel_early_when")}</strong>
              {t(locale, "sessions_page.condition_cancel_early_result")}
              <strong>{t(locale, "sessions_page.condition_cancel_early_amount")}</strong>.
            </li>
            <li>
              {t(locale, "sessions_page.condition_cancel_early")}
              <strong>{t(locale, "sessions_page.condition_cancel_late_when")}</strong>
              {t(locale, "sessions_page.condition_cancel_late_result")}
              <strong>{t(locale, "sessions_page.condition_cancel_late_amount")}</strong>.
            </li>
            <li>
              {t(locale, "sessions_page.condition_student_discount")}
              <strong>{t(locale, "sessions_page.condition_student_discount_detail")}</strong>
              {t(locale, "sessions_page.condition_student_proof")}
            </li>
          </ul>
        </Card>
        <Card variant="inverse">
          <Heading level="h3" variant="inverse">{t(locale, "sessions_page.why_heading")}</Heading>
          <ul class="mt-6 list-disc pl-4 text-white">
            <li>
              {t(locale, "sessions_page.why_workshop_prefix")}
              {" "}<strong>{t(locale, "sessions_page.why_workshop")}</strong> — {
                t(locale, "sessions_page.why_workshop_detail")
              }
            </li>
            <li>
              {t(locale, "sessions_page.why_real_projects_prefix")}
              {" "}<strong>{t(locale, "sessions_page.why_real_projects")}</strong>, {
                t(locale, "sessions_page.why_real_projects_detail")
              }
            </li>
            <li>
              {t(locale, "sessions_page.why_small_groups_prefix")}
              {" "}<strong>{t(locale, "sessions_page.why_small_groups")}</strong>, {
                t(locale, "sessions_page.why_small_groups_detail")
              }
            </li>
            <li>
              {t(locale, "sessions_page.why_materials_prefix")}
              {" "}<strong>{t(locale, "sessions_page.why_materials")}</strong>, {
                t(locale, "sessions_page.why_materials_detail")
              }
            </li>
            <li>
              {t(locale, "sessions_page.why_open_source_prefix")}
              {" "}<strong>{t(locale, "sessions_page.why_open_source")}</strong>, {
                t(locale, "sessions_page.why_open_source_detail")
              }
            </li>
            <li>
              {t(locale, "sessions_page.why_knowledge_prefix")}
              {" "}<strong>{t(locale, "sessions_page.why_knowledge")}</strong>, {
                t(locale, "sessions_page.why_knowledge_detail")
              }
            </li>
          </ul>
        </Card>
        <TrainingNewsletterSignUp client:load locale={locale} />
      </div>
    </Container>
  </Section>
  <TrainingGrid locale={locale} />
</Layout>
