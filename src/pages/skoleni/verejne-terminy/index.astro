---
import { TrainingNewsletterSignUp } from "../../../features/training/training-newsletter-signup";
import Seats from "../../../components/diagrams/Seats.astro";
import CourseRows from "../../../features/shared/CourseRows.astro";
import SessionRows from "../../../features/shared/SessionRows.astro";
import Layout from "../../../layouts/Layout.astro";

import {
  getFutureSessions,
  toTrainingSession,
  getTrainingIDToSlugMap,
  enrichSessionsWithSlugs,
  getSessionPrice,
} from "../../../lib/sessions";
import { t } from "../../../i18n";
import { getCurrencyForLocale } from "../../../i18n/formatting";
import { localizeUrl } from "../../../i18n/routes";
import { getLocalizedCollection } from "../../../lib/content";
import { getCatalog } from "../../../lib/catalog";
import { formatSessionCount } from "../../../i18n/formatting";

const locale = Astro.locals.locale;

const [sessionEntries, slugMap, allTrainings] = await Promise.all([
  getFutureSessions().catch(() => []),
  getTrainingIDToSlugMap(),
  getLocalizedCollection("training", locale),
]);

const descriptionMap = new Map<number, string>();
for (const tr of allTrainings) {
  if (tr.data.backofficeID > 0) {
    descriptionMap.set(tr.data.backofficeID, tr.data.description);
  }
}

const sessions = enrichSessionsWithSlugs(sessionEntries.map(toTrainingSession), slugMap).map((s) => ({
  ...s,
  trainingDescription: descriptionMap.get(s.trainingID),
}));

const meta = {
  title: t(locale, "sessions_page.meta_title"),
  description: t(locale, "sessions_page.meta_description"),
  keywords: t(locale, "sessions_page.meta_keywords"),
};

const trainings = allTrainings.filter(({ data }) => !data.draft);
const nextSession = sessions.length > 0 ? sessions[0] : null;

const openGraph = {
  type: "website" as const,
  image: {
    url: new URL(localizeUrl("/skoleni/verejne-terminy", locale) + "/card.png", Astro.site).toString(),
    width: 1200,
    height: 630,
    alt: t(locale, "sessions_page.og_alt"),
  },
};

// Generate Event schema for each training session
const jsonLd = {
  type: "ItemList" as const,
  items: sessions.map((session) => ({
    name: session.name,
    startDate: new Date(session.dates.start).toISOString(),
    ...(session.dates.end && {
      endDate: new Date(session.dates.end).toISOString(),
    }),
    location: session.location,
    organizerName: "Vojtěch Mareš",
    organizerUrl: new URL(localizeUrl("/", locale), Astro.site).toString().replace(/\/$/, ""),
    price: getSessionPrice(session.pricing, locale),
    priceCurrency: getCurrencyForLocale(locale),
    ...(session.signUpURL && {
      offerUrl: session.signUpURL,
    }),
    ...(session.trainingSlug && {
      url: new URL(localizeUrl(`/skoleni/${session.trainingSlug}`, locale), Astro.site).toString(),
    }),
  })),
};

const catalog = await getCatalog(locale);

const conditions = [
  [t(locale, "sessions_page.condition_binding")],
  [t(locale, "sessions_page.condition_min"), t(locale, "sessions_page.condition_min_count"), "."],
  [t(locale, "sessions_page.condition_max"), t(locale, "sessions_page.condition_max_count"), "."],
  [
    t(locale, "sessions_page.condition_confirmed"),
    t(locale, "sessions_page.condition_confirmed_when"),
    t(locale, "sessions_page.condition_confirmed_suffix"),
  ],
  [
    t(locale, "sessions_page.condition_cancel_early"),
    t(locale, "sessions_page.condition_cancel_early_when"),
    `${t(locale, "sessions_page.condition_cancel_early_result")} ${t(locale, "sessions_page.condition_cancel_early_amount")}.`,
  ],
  [
    t(locale, "sessions_page.condition_cancel_early"),
    t(locale, "sessions_page.condition_cancel_late_when"),
    `${t(locale, "sessions_page.condition_cancel_late_result")} ${t(locale, "sessions_page.condition_cancel_late_amount")}.`,
  ],
  [
    t(locale, "sessions_page.condition_student_discount"),
    t(locale, "sessions_page.condition_student_discount_detail"),
    t(locale, "sessions_page.condition_student_proof"),
  ],
];

const reasons = ["workshop", "real_projects", "small_groups", "materials", "open_source", "knowledge"].map((id) => [
  t(locale, `sessions_page.why_${id}_prefix` as Parameters<typeof t>[1]),
  t(locale, `sessions_page.why_${id}` as Parameters<typeof t>[1]),
  t(locale, `sessions_page.why_${id}_detail` as Parameters<typeof t>[1]),
]);
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <section class="section section--first">
    <div class="wrap split">
      <div>
        <a href={localizeUrl("/skoleni", locale)} class="back-link">← {t(locale, "course.back")}</a>
        <h1 class="h-page">{t(locale, "sessions_page.heading")}</h1>
        <p class="lead">{t(locale, "sessions_hero.description")}</p>
        {
          nextSession && (
            <p class="note note--status" style="margin-top: 16px">
              <span class="dot" aria-hidden="true" />
              {`${formatSessionCount(sessions.length, locale)} ${t(locale, "sessions_hero.sessions_upcoming")}`}
            </p>
          )
        }
      </div>
      <div class="split__media">
        <Seats n={1} caption={t(locale, "sessions_page.fig_seats")} />
      </div>
    </div>
  </section>

  <section id="terminy">
    <div class="wrap">
      {
        sessions.length > 0 ? (
          <SessionRows sessions={sessions} />
        ) : (
          <div class="rows">
            <p class="row row__desc">{t(locale, "sessions_hero.no_sessions_text")}</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section" id="podminky">
    <div class="wrap aside-split">
      <h2 class="h2">{t(locale, "sessions_page.conditions_heading")}</h2>
      <ul class="rows">
        {
          conditions.map(([before, strong, after]) => (
            <li class="row">
              <span class="row__desc">
                {before} {strong && <strong style="color: var(--ink); font-weight: 500">{strong}</strong>} {after}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap aside-split">
      <h2 class="h2">{t(locale, "sessions_page.why_heading")}</h2>
      <ol class="rows">
        {
          reasons.map(([before, strong, after], index) => (
            <li class="row row--step">
              <span class="row__num">{String(index + 1).padStart(2, "0")}</span>
              <span class="row__desc">
                {before} <strong style="color: var(--ink); font-weight: 500">{strong}</strong> – {after}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap aside-split">
      <p class="eyebrow">{t(locale, "course.newsletter_eyebrow")}</p>
      <div style="max-width: 520px">
        <TrainingNewsletterSignUp client:load locale={locale} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t(locale, "home.training_eyebrow")}</p>
          <h2 class="h2">{t(locale, "home.training_heading")}</h2>
        </div>
        <a href={localizeUrl("/skoleni", locale)} class="link-arrow">{t(locale, "home.training_link")} →</a>
      </div>
      <CourseRows courses={catalog} compact />
    </div>
  </section>
</Layout>
