---
import { Container } from "../../../components/ui/container";
import { Heading } from "../../../components/ui/heading";
import { TrainingSessionsTable } from "../../../features/training/training-sessions-table";
import { SessionsHero } from "../../../features/training/sessions-hero";
import Layout from "../../../layouts/Layout.astro";

import { getCollection } from "astro:content";
import {
  getFutureSessions,
  toTrainingSession,
  getTrainingIDToSlugMap,
  enrichSessionsWithSlugs,
} from "../../../lib/sessions";
import { Section } from "../../../components/ui/section";
import { Card } from "../../../components/ui/card";
import { TrainingGrid } from "../../../features/training/training-grid";
import { CachePresets } from "../../../lib/cache";

Astro.response.headers.set("Cache-Control", CachePresets.training);

const [sessionEntries, slugMap, allTrainings] = await Promise.all([
  getFutureSessions(),
  getTrainingIDToSlugMap(),
  getCollection("training"),
]);

const descriptionMap = new Map<number, string>();
for (const t of allTrainings) {
  if (t.data.backofficeID > 0) {
    descriptionMap.set(t.data.backofficeID, t.data.description);
  }
}

const sessions = enrichSessionsWithSlugs(sessionEntries.map(toTrainingSession), slugMap).map((s) => ({
  ...s,
  trainingDescription: descriptionMap.get(s.trainingID),
}));

const meta = {
  title: "Vojtěch Mareš | Veřejné termíny školení",
  description:
    "Vypsané veřejné termíny školení, na které se může přihlásit každý. A nebo pokud nechcete firemní školení, ale jen poslat například pár zaměstnanců...",
  keywords: "školení, termíny, devops školení, termín školení",
};

const trainings = allTrainings.filter(({ data }) => !data.draft);
const nextSession = sessions.length > 0 ? sessions[0] : null;

const openGraph = {
  type: "website" as const,
  image: {
    url: Astro.url + "/card.png",
    width: 1200,
    height: 630,
    alt: "Veřejné termíny školení",
  },
};

const baseUrl = Astro.url?.toString().replace(/\/$/, "") || "https://www.mares.cz";

// Generate Event schema for each training session
const jsonLd = {
  type: "ItemList" as const,
  items: sessions.map((session) => ({
    name: session.name,
    startDate: new Date(session.dates.start).toISOString(),
    ...(session.dates.end && {
      endDate: new Date(session.dates.end).toISOString(),
    }),
    location: session.location,
    organizerName: "Vojtěch Mareš",
    organizerUrl: baseUrl,
    price: session.price,
    priceCurrency: "CZK",
    ...(session.signUpURL && {
      offerUrl: session.signUpURL,
    }),
  })),
};
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <SessionsHero
    sessionCount={sessions.length}
    topicCount={trainings.length}
    nextSessionDate={nextSession ? new Date(nextSession.dates.start).toISOString() : null}
  />
  <Section id="terminy">
    <Container>
      <TrainingSessionsTable sessions={sessions} />
      <div class="mt-12 grid grid-cols-1 gap-8 sm:mt-18 md:grid-cols-2">
        <Card variant="surface">
          <Heading level="h3" id="podminky"> Podmínky veřejných termínů školení </Heading>
          <ul class="mt-6 list-disc pl-4">
            <li>Přihlášení na veřejný termín školení je závazné a zavazujete se k platbě.</li>
            <li>
              Minimální počet účastníků pro uskuteční školení je <strong>5</strong>.
            </li>
            <li>
              Maximální počet účastníků na termínu je <strong>12</strong>.
            </li>
            <li>
              Školení je potvrzeno <strong>týden</strong> předem, nebo zrušeno z důvodu nízké účasti.
            </li>
            <li>
              Při odhlášení <strong>min. týden předem</strong> vracím <strong>plnou částku</strong>.
            </li>
            <li>
              Při odhlášení <strong>méně jak týden předem</strong> vracím pouze
              <strong>50% z ceny školení</strong>.
            </li>
            <li>
              Nabízím slevu <strong>50% pro studenty denního studia</strong> při doložení platného dokladu (potvrzení o studiu).
            </li>
          </ul>
        </Card>
        <Card variant="inverse">
          <Heading level="h3" variant="inverse">Proč přijít právě na moje školení?</Heading>
          <ul class="mt-6 list-disc pl-4 text-white">
            <li>
              Školení probíhají
              <strong>formou workshopu</strong> — vše si prakticky vyzkoušíte na vlastním počítači.
            </li>
            <li>
              Ukázky a příklady vycházejí z
              <strong>reálných projektů</strong>, ne z učebnic.
            </li>
            <li>
              Ve skupině je
              <strong>maximálně 12 účastníků</strong>, takže je prostor pro vaše dotazy.
            </li>
            <li>
              Obdržíte
              <strong>všechny materiály a ukázkový kód</strong>, ke kterým se můžete kdykoli vrátit.
            </li>
            <li>
              Pracujeme výhradně s
              <strong>open-source nástroji</strong>, které jsou standardem v oboru.
            </li>
            <li>
              Mým cílem je
              <strong>předat vám know-how</strong>, abyste byli po školení soběstační.
            </li>
          </ul>
        </Card>
      </div>
    </Container>
  </Section>
  <TrainingGrid />
</Layout>
