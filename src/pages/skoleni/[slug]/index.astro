---
import { render } from "astro:content";
import Terminal from "../../../components/diagrams/Terminal.astro";
import SessionRows from "../../../features/shared/SessionRows.astro";
import Toc from "../../../features/shared/Toc.astro";
import { TrainingNewsletterSignUp } from "../../../features/training/training-newsletter-signup";
import Layout from "../../../layouts/Layout.astro";
import { getFutureSessionsByName, toTrainingSession } from "../../../lib/sessions";
import { getTrainingTerminal } from "../../../lib/training-terminals";
import { MeetingUrl } from "../../../lib/site";
import { t } from "../../../i18n";
import { formatDuration, formatPrice, getCurrencyForLocale } from "../../../i18n/formatting";
import { getLocalizedEntry, getLocalizedCollection, bareSlug } from "../../../lib/content";
import { localizeUrl } from "../../../i18n/routes";
import { truncateDescription, formatCourseTimeRequired } from "../../../lib/seo";

const locale = Astro.locals.locale;

const { slug } = Astro.params;

const training = await getLocalizedEntry("training", slug!, locale);
if (!training || training.data.draft) {
  const allTrainings = await getLocalizedCollection(
    "training",
    locale,
    ({ data }) => !data.draft && data.redirectFrom?.includes(slug!),
  );
  if (allTrainings.length > 0) {
    return Astro.redirect(localizeUrl(`/skoleni/${bareSlug(allTrainings[0].id)}`, locale), 301);
  }
  return Astro.redirect("/404", 404);
}

const sessionEntries = await getFutureSessionsByName(training.data.title).catch(() => []);
const sessions = sessionEntries.map(toTrainingSession);

const meta = {
  title: "Vojtěch Mareš | " + training.data.title + " " + t(locale, "training_page.training_suffix"),
  description: truncateDescription(training.data.description),
  keywords: training.data.keywords.join(","),
};

const openGraph = {
  type: "article" as const,
  image: {
    url: new URL(localizeUrl("/skoleni/" + slug, locale) + "/card.png", Astro.site).toString(),
    width: 1200,
    height: 630,
    alt: training.data.title + ": " + training.data.description,
  },
};

const currency = getCurrencyForLocale(locale);
const pricing = {
  open: training.data.price.open.filter((variant) => variant.currency === currency)[0].amount,
  corporate: training.data.price.corporate.filter((variant) => variant.currency === currency)[0].amount,
};

const jsonLd = {
  type: "Course" as const,
  name: training.data.title + " " + t(locale, "training_page.training_suffix"),
  description: training.data.description,
  provider: {
    name: "Vojtěch Mareš",
    url: new URL(localizeUrl("/", locale), Astro.site).toString().replace(/\/$/, ""),
  },
  offers: {
    price: pricing.open,
    priceCurrency: currency,
  },
  inLanguage: locale === "en" ? "en" : "cs",
  timeRequired: formatCourseTimeRequired(training.data.length),
  courseCode: slug,
  ...(sessions.length > 0 && {
    hasCourseInstance: sessions.map((session) => ({
      startDate: new Date(session.dates.start).toISOString(),
      ...(session.dates.end && {
        endDate: new Date(session.dates.end).toISOString(),
      }),
      courseMode: "Offline",
      location: session.location,
    })),
  }),
};

const { Content, headings } = await render(training);

const icon = training.data.icon ?? training.data.logo;
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <section class="section section--first">
    <div class="wrap split">
      <div>
        <a href={localizeUrl("/skoleni", locale)} class="back-link">← {t(locale, "course.back")}</a>
        <div class="course-title">
          {icon && <img class="tech-mark" src={icon.src} alt="" width="36" height="36" />}
          <h1 class="h-page">{training.data.title}</h1>
        </div>
        <p class="lead" style="margin-top: 24px">{training.data.description}</p>

        <dl class="meta-list">
          <dt>{t(locale, "course.length")}</dt>
          <dd>{formatDuration(training.data.length, locale)} ({training.data.length * 8} h)</dd>
          <dt>{t(locale, "course.form")}</dt>
          <dd>{t(locale, "course.form_value")}</dd>
          <dt>{t(locale, "course.price_open")}</dt>
          <dd class="mono">
            {formatPrice(pricing.open, locale)} / {t(locale, "price.per_person")}
          </dd>
          <dt>{t(locale, "course.price_corporate")}</dt>
          <dd class="mono">
            {formatPrice(pricing.corporate, locale)} / {t(locale, "price.per_session")}
          </dd>
        </dl>

        <div class="actions">
          <a href={MeetingUrl} class="btn btn--primary">{t(locale, "course.cta")}</a>
          <a href="#terminy" class="link-arrow link-arrow--ink">{t(locale, "course.cta_sessions")} →</a>
        </div>
      </div>
      <div class="split__media">
        <Terminal
          n={1}
          id="course"
          chrome
          caption={t(locale, "course.fig_terminal")}
          lines={getTrainingTerminal(slug!)}
        />
      </div>
    </div>
  </section>

  <section id="obsah">
    <div class="wrap article-grid article-grid--aside">
      <Toc headings={headings} title={t(locale, "course.toc")} />
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  <section class="section" id="terminy">
    <div class="wrap aside-split">
      <div>
        <p class="eyebrow">{t(locale, "course.sessions_eyebrow")}</p>
        <h2 class="h2">{t(locale, "training_page.public_sessions")}</h2>
      </div>
      <div>
        {
          sessions.length > 0 ? (
            <SessionRows sessions={sessions} compact />
          ) : (
            <div class="rows">
              <p class="row row__desc">{t(locale, "sessions_hero.no_sessions_text")}</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap aside-split">
      <div>
        <p class="eyebrow">{t(locale, "course.price_eyebrow")}</p>
        <h2 class="h2">{t(locale, "training_page.price_label")}</h2>
      </div>
      <div>
        <div class="rows">
          <div class="row row--service">
            <span class="row__title">{t(locale, "training_page.public_session")}</span>
            <span class="row__desc">{t(locale, "services_training.public_sessions_description")}</span>
            <span class="row__value row__value--end">
              {formatPrice(pricing.open, locale)}
              <span class="row__unit"> {t(locale, "training_page.excl_vat")}</span>
            </span>
          </div>
          <div class="row row--service">
            <span class="row__title">{t(locale, "training_page.corporate_training")}</span>
            <span class="row__desc">{t(locale, "services_training.corporate_description")}</span>
            <span class="row__value row__value--end">
              {formatPrice(pricing.corporate, locale)}
              <span class="row__unit"> {t(locale, "training_page.excl_vat")}</span>
            </span>
          </div>
        </div>
        <div class="actions">
          <a href="mailto:vojtech@mares.cz" class="btn btn--primary">{t(locale, "training_page.request_quote")}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap aside-split">
      <div>
        <p class="eyebrow">{t(locale, "course.newsletter_eyebrow")}</p>
      </div>
      <div style="max-width: 520px">
        <TrainingNewsletterSignUp client:load locale={locale} trainingSlug={slug} />
      </div>
    </div>
  </section>
</Layout>
