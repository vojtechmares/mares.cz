---
import { getEntry, render } from "astro:content";
import { Logo } from "../../../features/training/logo";
import { CompactTrainingSessionsTable } from "../../../features/training/training-sessions-table";
import { Body } from "../../../components/ui/body";
import { Button } from "../../../components/ui/button";
import { Card } from "../../../components/ui/card";
import { Container } from "../../../components/ui/container";
import { Heading } from "../../../components/ui/heading";
import Layout from "../../../layouts/Layout.astro";
import { getFutureSessionsByName, toTrainingSession } from "../../../lib/sessions";
import { Section } from "../../../components/ui/section";
import { Prose } from "../../../components/prose";
import { CachePresets } from "../../../lib/cache";

const { slug } = Astro.params;

const training = await getEntry("training", slug!);
if (!training || training.data.draft) {
  return Astro.redirect("/404", 404);
}

Astro.response.headers.set("Cache-Control", CachePresets.training);

const sessionEntries = await getFutureSessionsByName(training.data.title);
const sessions = sessionEntries.map(toTrainingSession);

const formatter = new Intl.NumberFormat("cs", {
  style: "currency",
  currency: "CZK",
  maximumFractionDigits: 0,
});

const meta = {
  title: "Vojtěch Mareš | " + training.data.title + " školení",
  description: training.data.description,
  keywords: training.data.keywords.join(","),
};

const openGraph = {
  type: "article" as const,
  image: {
    url: Astro.url + "/card.png",
    width: 1200,
    height: 630,
    alt: training.data.title + ": " + training.data.description,
  },
};

const baseUrl = Astro.url?.toString().replace(/\/$/, "") || "https://www.mares.cz";

const pricing = {
  open: training.data.price.open.filter((variant) => variant.currency === "CZK")[0].amount,
  corporate: training.data.price.corporate.filter((variant) => variant.currency === "CZK")[0].amount,
};

const jsonLd = {
  type: "Course" as const,
  name: training.data.title + " školení",
  description: training.data.description,
  provider: {
    name: "Vojtěch Mareš",
    url: baseUrl,
  },
  offers: {
    price: pricing.open,
    priceCurrency: "CZK",
  },
  ...(sessions.length > 0 && {
    hasCourseInstance: sessions.map((session) => ({
      startDate: new Date(session.dates.start).toISOString(),
      ...(session.dates.end && {
        endDate: new Date(session.dates.end).toISOString(),
      }),
      courseMode: "Offline",
      location: session.location,
    })),
  }),
};

const { Content } = await render(training);
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <Section variant="inverse">
    <Container className="flex flex-col">
      <div class="flex items-center justify-between">
        <Heading level="h1" variant="inverse">
          {training.data.title} školení
        </Heading>
        <!-- <h1
            class="font-display self-center text-center text-5xl font-black tracking-tight text-white sm:text-6xl"
          >
            {training.title} školení
          </h1> -->
        <Logo training={training} />
      </div>
    </Container>
  </Section>
  <Section>
    <Container className={training.data.draft ? "hidden" : ""}>
      <div class="md:grid md:grid-cols-5 md:gap-x-4 md:gap-y-4">
        <div class="md:col-span-3">
          <Prose>
            <Content />
          </Prose>
        </div>
        <div class="mt-8 md:col-span-2 md:mt-0">
          {
            sessions.length > 0 ? (
              <Card className="mb-10" variant="surface">
                <Heading level="h2" className="mb-4">
                  Veřejné termíny školení
                </Heading>
                <CompactTrainingSessionsTable sessions={sessions} />
              </Card>
            ) : null
          }
          <Card className="mb-10" variant="surface">
            <Heading level="h2" className="mb-4">Cena za školení</Heading>
            <dl class="sm:divide-y sm:divide-zinc-300">
              <div class="sm:grid sm:grid-cols-2 sm:gap-4 sm:py-5">
                <dt class="font-medium text-zinc-700">Veřejný termín</dt>
                <dd class="text-zinc-900">
                  {formatter.format(pricing.open)} bez DPH
                </dd>
              </div>
              <div class="sm:grid sm:grid-cols-2 sm:gap-4 sm:py-5">
                <dt class="font-medium text-zinc-700">Firemní školení</dt>
                <dd class="text-zinc-900">
                  {formatter.format(pricing.corporate)} bez DPH
                </dd>
              </div>
            </dl>
            <Button variant="accent" className="text-lg font-medium" href="mailto:vojtech@mares.cz">
              Nezávazně poptat
            </Button>
          </Card>
          {
            training.data.length === 2 ? (
              <Card className="mb-10" variant="surface">
                <div class="flex">
                  <div class="shrink-0">
                    {/* <ExclamationTriangleIcon class="h-5 w-5 text-yellow-400" aria-hidden="true" /> */}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-6 w-6 text-blue-400"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </div>
                  <div class="ml-3">
                    <Body color="primary" className="text-xl text-blue-600">
                      Toto školení je{" "}
                      <Body as="span" className="font-medium">
                        dvoudenní.
                      </Body>
                    </Body>
                  </div>
                </div>
              </Card>
            ) : null
          }
        </div>
      </div>
    </Container>
  </Section>
  <!-- {training.publishedAt !== null && (
        <Section>
         <Container
           className="my-32 flex justify-center"
         >
        <h1 class="text-4xl font-bold">Toto školení teprve připravuji.</h1>
      </Container>
      </Section>
      )} -->
</Layout>
