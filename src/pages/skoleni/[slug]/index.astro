---
import { render } from "astro:content";
import { TrainingHero } from "../../../features/training/training-hero";
import { CompactTrainingSessionsTable } from "../../../features/training/training-sessions-table";
import { Button } from "../../../components/ui/button";
import { Card } from "../../../components/ui/card";
import { Container } from "../../../components/ui/container";
import { Heading } from "../../../components/ui/heading";
import Layout from "../../../layouts/Layout.astro";
import { getFutureSessionsByName, toTrainingSession } from "../../../lib/sessions";
import { Section } from "../../../components/ui/section";
import { Prose } from "../../../components/prose";
import { t } from "../../../i18n";
import { formatPrice, getCurrencyForLocale } from "../../../i18n/formatting";
import { getLocalizedEntry, getLocalizedCollection, bareSlug } from "../../../lib/content";
import { localizeUrl } from "../../../i18n/routes";
import { truncateDescription, formatCourseTimeRequired } from "../../../lib/seo";

const locale = Astro.locals.locale;

const { slug } = Astro.params;

const training = await getLocalizedEntry("training", slug!, locale);
if (!training || training.data.draft) {
  const allTrainings = await getLocalizedCollection(
    "training",
    locale,
    ({ data }) => !data.draft && data.redirectFrom?.includes(slug!),
  );
  if (allTrainings.length > 0) {
    return Astro.redirect(localizeUrl(`/skoleni/${bareSlug(allTrainings[0].id)}`, locale), 301);
  }
  return Astro.redirect("/404", 404);
}

const sessionEntries = await getFutureSessionsByName(training.data.title);
const sessions = sessionEntries.map(toTrainingSession);

const meta = {
  title: "Vojtěch Mareš | " + training.data.title + " " + t(locale, "training_page.training_suffix"),
  description: truncateDescription(training.data.description),
  keywords: training.data.keywords.join(","),
};

const openGraph = {
  type: "article" as const,
  image: {
    url: new URL(localizeUrl("/skoleni/" + slug, locale) + "/card.png", Astro.site).toString(),
    width: 1200,
    height: 630,
    alt: training.data.title + ": " + training.data.description,
  },
};

const currency = getCurrencyForLocale(locale);
const pricing = {
  open: training.data.price.open.filter((variant) => variant.currency === currency)[0].amount,
  corporate: training.data.price.corporate.filter((variant) => variant.currency === currency)[0].amount,
};

const jsonLd = {
  type: "Course" as const,
  name: training.data.title + " " + t(locale, "training_page.training_suffix"),
  description: training.data.description,
  provider: {
    name: "Vojtěch Mareš",
    url: new URL(localizeUrl("/", locale), Astro.site).toString().replace(/\/$/, ""),
  },
  offers: {
    price: pricing.open,
    priceCurrency: currency,
  },
  inLanguage: locale === "en" ? "en" : "cs",
  timeRequired: formatCourseTimeRequired(training.data.length),
  courseCode: slug,
  ...(sessions.length > 0 && {
    hasCourseInstance: sessions.map((session) => ({
      startDate: new Date(session.dates.start).toISOString(),
      ...(session.dates.end && {
        endDate: new Date(session.dates.end).toISOString(),
      }),
      courseMode: "Offline",
      location: session.location,
    })),
  }),
};

const { Content } = await render(training);
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <TrainingHero
    title={training.data.title}
    description={training.data.description}
    length={training.data.length}
    price={pricing.open}
    logo={training.data.logo ?? training.data.icon}
    locale={locale}
  />
  <Section id="obsah">
    <Container className={training.data.draft ? "hidden" : ""}>
      <div class="md:grid md:grid-cols-5 md:gap-x-4 md:gap-y-4">
        <div class="md:col-span-3">
          <Prose>
            <Content />
          </Prose>
        </div>
        <div class="mt-8 md:col-span-2 md:mt-0">
          {
            sessions.length > 0 ? (
              <Card id="terminy" className="mb-10" variant="surface">
                <Heading level="h2" className="mb-4">
                  {t(locale, "training_page.public_sessions")}
                </Heading>
                <CompactTrainingSessionsTable sessions={sessions} locale={locale} />
              </Card>
            ) : null
          }
          <Card className="mb-10" variant="surface">
            <Heading level="h2" className="mb-4">{t(locale, "training_page.price_label")}</Heading>
            <dl class="sm:divide-y sm:divide-zinc-300">
              <div class="sm:grid sm:grid-cols-2 sm:gap-4 sm:py-5">
                <dt class="font-medium text-zinc-700">{t(locale, "training_page.public_session")}</dt>
                <dd class="text-zinc-900">
                  {formatPrice(pricing.open, locale)}
                  {t(locale, "training_page.excl_vat")}
                </dd>
              </div>
              <div class="sm:grid sm:grid-cols-2 sm:gap-4 sm:py-5">
                <dt class="font-medium text-zinc-700">{t(locale, "training_page.corporate_training")}</dt>
                <dd class="text-zinc-900">
                  {formatPrice(pricing.corporate, locale)}
                  {t(locale, "training_page.excl_vat")}
                </dd>
              </div>
            </dl>
            <Button variant="accent" className="text-lg font-medium" href="mailto:vojtech@mares.cz">
              {t(locale, "training_page.request_quote")}
            </Button>
          </Card>
        </div>
      </div>
    </Container>
  </Section>
</Layout>
