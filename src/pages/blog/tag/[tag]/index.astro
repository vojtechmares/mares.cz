---
import { getCollection } from "astro:content";
import { Container } from "../../../../components/ui/container";
import { Heading } from "../../../../components/ui/heading";
import { Link } from "../../../../components/ui/link";
import { Section } from "../../../../components/ui/section";
import { Text } from "../../../../components/ui/text";
import Layout from "../../../../layouts/Layout.astro";
import { ArticleGrid } from "../../../../features/blog/article-grid";
import { CachePresets } from "../../../../lib/cache";

const { tag } = Astro.params;
if (!tag) {
  return Astro.redirect("/404", 404);
}

const articles = await getCollection("blog", ({ data }) => !data.draft && data.tags.includes(tag));

if (articles.length === 0) {
  return Astro.redirect("/404", 404);
}

const sortedArticles = articles.sort((a, b) => b.data.publish_time.valueOf() - a.data.publish_time.valueOf());

Astro.response.headers.set("Cache-Control", CachePresets.archive);

const meta = {
  title: `Vojtěch Mareš | Blog: #${tag}`,
  description: `Články na téma ${tag} na blogu Vojtěcha Mareše. ${articles.length} článků o ${tag}.`,
  keywords: `${tag}, blog, devops, ${tag} články`,
};

const baseUrl = Astro.url?.toString().replace(/\/$/, "") || "https://www.mares.cz";

const openGraph = {
  type: "website" as const,
  image: {
    url: `${baseUrl}/blog/tag/${tag}/card.png`,
    width: 1200,
    height: 630,
    alt: `Blog: #${tag}`,
  },
};

const jsonLd = {
  type: "CollectionPage" as const,
  name: `Články s tagem #${tag}`,
  description: meta.description,
  url: `${baseUrl}/blog/tag/${tag}`,
  numberOfItems: articles.length,
};
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse">Blog: #{tag}</Heading>
      <Text variant="inverse" className="mt-4">
        {sortedArticles.length} článků s tímto tagem
      </Text>
      <Text variant="inverse" className="mt-2">
        <Link href="/blog" className="text-zinc-100">← Zpět na blog</Link>
      </Text>
    </Container>
  </Section>
  <Section>
    <ArticleGrid articles={sortedArticles} />
  </Section>
</Layout>
