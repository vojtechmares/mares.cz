---
import BlogListing from "../../../../features/blog/BlogListing.astro";
import Layout from "../../../../layouts/Layout.astro";
import { t } from "../../../../i18n";
import { localizeUrl } from "../../../../i18n/routes";
import { getLocalizedCollection } from "../../../../lib/content";

const locale = Astro.locals.locale;

const { tag } = Astro.params;
if (!tag) {
  return Astro.redirect("/404", 404);
}

const articles = await getLocalizedCollection("blog", locale, ({ data }) => !data.draft && data.tags.includes(tag));

if (articles.length === 0) {
  return Astro.redirect("/404", 404);
}

const sortedArticles = articles.sort((a, b) => b.data.publish_time.valueOf() - a.data.publish_time.valueOf());

const meta = {
  title: t(locale, "blog.tag_meta_title", { tag }),
  description: t(locale, "blog.tag_meta_description", { tag, count: articles.length }),
  keywords: t(locale, "blog.tag_meta_keywords", { tag }),
};

const openGraph = {
  type: "website" as const,
  image: {
    url: new URL(localizeUrl("/blog/tag/" + tag, locale) + "/card.png", Astro.site).toString(),
    width: 1200,
    height: 630,
    alt: `Blog: #${tag}`,
  },
};

const jsonLd = {
  type: "CollectionPage" as const,
  name: t(locale, "blog.tag_heading", { tag }),
  description: meta.description,
  url: new URL(localizeUrl("/blog/tag/" + tag, locale), Astro.site).toString(),
};
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <BlogListing
    back
    title={`#${tag}`}
    lead={`${sortedArticles.length} ${t(locale, "blog.tag_article_count_suffix")}`}
    articles={sortedArticles}
  />
</Layout>
