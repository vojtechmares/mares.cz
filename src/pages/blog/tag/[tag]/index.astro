---
import { Container } from "../../../../components/ui/container";
import { Heading } from "../../../../components/ui/heading";
import { Link } from "../../../../components/ui/link";
import { Section } from "../../../../components/ui/section";
import { Text } from "../../../../components/ui/text";
import Layout from "../../../../layouts/Layout.astro";
import { ArticleGrid } from "../../../../features/blog/article-grid";
import { CachePresets } from "../../../../lib/cache";
import { t } from "../../../../i18n";
import { localizeUrl } from "../../../../i18n/routes";
import { getLocalizedCollection } from "../../../../lib/content";

const locale = Astro.locals.locale;

const { tag } = Astro.params;
if (!tag) {
  return Astro.redirect("/404", 404);
}

const articles = await getLocalizedCollection("blog", locale, ({ data }) => !data.draft && data.tags.includes(tag));

if (articles.length === 0) {
  return Astro.redirect("/404", 404);
}

const sortedArticles = articles.sort((a, b) => b.data.publish_time.valueOf() - a.data.publish_time.valueOf());

Astro.response.headers.set("Cache-Control", CachePresets.archive);

const meta = {
  title: t(locale, "blog.tag_meta_title", { tag }),
  description: t(locale, "blog.tag_meta_description", { tag, count: articles.length }),
  keywords: t(locale, "blog.tag_meta_keywords", { tag }),
};

const baseUrl = Astro.url?.toString().replace(/\/$/, "") || "https://www.mares.cz";

const openGraph = {
  type: "website" as const,
  image: {
    url: `${baseUrl}/blog/tag/${tag}/card.png`,
    width: 1200,
    height: 630,
    alt: `Blog: #${tag}`,
  },
};

const jsonLd = {
  type: "CollectionPage" as const,
  name: t(locale, "blog.tag_heading", { tag }),
  description: meta.description,
  url: `${baseUrl}/blog/tag/${tag}`,
};
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse">Blog: #{tag}</Heading>
      <Text variant="inverse" className="mt-4">
        {sortedArticles.length}
        {t(locale, "blog.tag_article_count_suffix")}
      </Text>
      <Text variant="inverse" className="mt-2">
        <Link href={localizeUrl("/blog", locale)} className="text-zinc-100">{t(locale, "blog.back_to_blog")}</Link>
      </Text>
    </Container>
  </Section>
  <Section>
    <ArticleGrid articles={sortedArticles} locale={locale} />
  </Section>
</Layout>
