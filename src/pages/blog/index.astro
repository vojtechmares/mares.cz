---
import { getCollection } from "astro:content";
import { Container } from "../../components/ui/container";
import { Heading } from "../../components/ui/heading";
import { Section } from "../../components/ui/section";
import Layout from "../../layouts/Layout.astro";
import { ArticleGrid } from "../../features/blog/article-grid";

// switch to static page rendering during build time
export const prerender = true;

const articles = (
  await getCollection("blog", ({ data }) => {
    return !data.draft;
  })
).sort((a, b) => {
  return b.data.publish_time.valueOf() - a.data.publish_time.valueOf();
});

let tags: string[] = [];
for (const article of articles) {
  tags.push(...article.data.tags);
}
tags = [...new Set(tags)];

// Extract years for archive navigation
const currentYear = new Date().getFullYear();
const years = [
  ...new Set(articles.map((a) => a.data.publish_time.getFullYear()).filter((y) => y <= currentYear + 1 && y >= 2020)),
].sort((a, b) => b - a);

const meta = {
  title: "Vojtěch Mareš | Blog",
  description: "Články na méme blogu nejen o DevOps.",
  keywords: "blog, devops blog, články",
};
---

<Layout meta={meta}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse">Blog</Heading>
      <p class="mt-4 text-base text-zinc-100 lg:text-xl">
        {
          tags.map((tag) =>
            // prettier-ignore
            <><a href={`/blog/tag/${tag}`} class="underline">#{tag}</a>{" "}</>,
          )
        }
      </p>
      <div class="mt-4 flex flex-row justify-between">
        <p class="mt-2 text-base text-zinc-100 lg:text-xl">
          Archiv:{" "}
          {
            years.map((year, i) =>
              // prettier-ignore
              <><a href={`/blog/archive/${year}`} class="underline">{year}</a>{i < years.length - 1 ? " · " : ""}</>,
            )
          }
        </p>
        <p class="mt-2 text-base text-zinc-100 lg:text-xl">
          Feed:{" "}
          <a class="underline" type="application/rss+xml" href="/blog/rss.xml">RSS</a>
        </p>
      </div>
    </Container>
  </Section>
  <Section>
    <ArticleGrid articles={articles} />
  </Section>
</Layout>
