---
import { Container } from "../../components/ui/container";
import { Heading } from "../../components/ui/heading";
import { Link } from "../../components/ui/link";
import { Section } from "../../components/ui/section";
import { Text } from "../../components/ui/text";
import Layout from "../../layouts/Layout.astro";
import { ArticleGrid } from "../../features/blog/article-grid";
import { CachePresets } from "../../lib/cache";
import { t } from "../../i18n";
import { localizeUrl } from "../../i18n/routes";
import { getLocalizedCollection } from "../../lib/content";

const locale = Astro.locals.locale;

Astro.response.headers.set("Cache-Control", CachePresets.archive);

const articles = (
  await getLocalizedCollection("blog", locale, ({ data }) => {
    return !data.draft;
  })
).sort((a, b) => {
  return b.data.publish_time.valueOf() - a.data.publish_time.valueOf();
});

let tags: string[] = [];
for (const article of articles) {
  tags.push(...article.data.tags);
}
tags = [...new Set(tags)];

// Extract years for archive navigation
const currentYear = new Date().getFullYear();
const years = [
  ...new Set(articles.map((a) => a.data.publish_time.getFullYear()).filter((y) => y <= currentYear + 1 && y >= 2020)),
].sort((a, b) => b - a);

const meta = {
  title: t(locale, "blog.meta_title"),
  description: t(locale, "blog.meta_description"),
  keywords: t(locale, "blog.meta_keywords"),
};

const openGraph = {
  type: "website" as const,
  image: {
    url: new URL(localizeUrl("/blog", locale) + "/card.png", Astro.site).toString(),
    width: 1200,
    height: 630,
    alt: t(locale, "blog.og_alt"),
  },
};

const jsonLd = {
  type: "CollectionPage" as const,
  name: t(locale, "blog.meta_title"),
  description: t(locale, "blog.meta_description"),
  url: new URL(localizeUrl("/blog", locale), Astro.site).toString(),
};
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse">Blog</Heading>
      <Text variant="inverse" className="mt-4">
        {
          tags.map((tag) =>
            // prettier-ignore
            <><Link href={localizeUrl(`/blog/tag/${tag}`, locale)} className="text-zinc-100">#{tag}</Link>{" "}</>,
          )
        }
      </Text>
      <div class="mt-4 flex flex-row justify-between">
        <Text variant="inverse" className="mt-2">
          {t(locale, "blog.archive_label")}{" "}
          {
            years.map((year, i) =>
              // prettier-ignore
              <><Link href={localizeUrl(`/blog/archive/${year}`, locale)} className="text-zinc-100">{year}</Link>{i < years.length - 1 ? " · " : ""}</>,
            )
          }
        </Text>
        <Text variant="inverse" className="mt-2">
          {t(locale, "blog.feed_label")}{" "}
          <Link href={localizeUrl("/blog/rss.xml", locale)} className="text-zinc-100">RSS</Link>
        </Text>
      </div>
    </Container>
  </Section>
  <Section>
    <ArticleGrid articles={articles} locale={locale} />
  </Section>
</Layout>
