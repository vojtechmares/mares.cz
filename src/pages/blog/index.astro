---
import { getCollection } from "astro:content";
import { Container } from "../../components/ui/container";
import { Heading } from "../../components/ui/heading";
import { Link } from "../../components/ui/link";
import { Section } from "../../components/ui/section";
import { Text } from "../../components/ui/text";
import Layout from "../../layouts/Layout.astro";
import { ArticleGrid } from "../../features/blog/article-grid";

// switch to static page rendering during build time
export const prerender = true;

const articles = (
  await getCollection("blog", ({ data }) => {
    return !data.draft;
  })
).sort((a, b) => {
  return b.data.publish_time.valueOf() - a.data.publish_time.valueOf();
});

let tags: string[] = [];
for (const article of articles) {
  tags.push(...article.data.tags);
}
tags = [...new Set(tags)];

// Extract years for archive navigation
const currentYear = new Date().getFullYear();
const years = [
  ...new Set(articles.map((a) => a.data.publish_time.getFullYear()).filter((y) => y <= currentYear + 1 && y >= 2020)),
].sort((a, b) => b - a);

const meta = {
  title: "Vojtěch Mareš | Blog",
  description: "Články na méme blogu nejen o DevOps.",
  keywords: "blog, devops blog, články",
};
---

<Layout meta={meta}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse">Blog</Heading>
      <Text variant="inverse" className="mt-4">
        {
          tags.map((tag) =>
            // prettier-ignore
            <><Link href={`/blog/tag/${tag}`} className="text-zinc-100">#{tag}</Link>{" "}</>,
          )
        }
      </Text>
      <div class="mt-4 flex flex-row justify-between">
        <Text variant="inverse" className="mt-2">
          Archiv:{" "}
          {
            years.map((year, i) =>
              // prettier-ignore
              <><Link href={`/blog/archive/${year}`} className="text-zinc-100">{year}</Link>{i < years.length - 1 ? " · " : ""}</>,
            )
          }
        </Text>
        <Text variant="inverse" className="mt-2">
          Feed:{" "}
          <Link href="/blog/rss.xml" className="text-zinc-100">RSS</Link>
        </Text>
      </div>
    </Container>
  </Section>
  <Section>
    <ArticleGrid articles={articles} />
  </Section>
</Layout>
