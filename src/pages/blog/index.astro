---
import { Button } from "../../components/ui/button";
import { Card } from "../../components/ui/card";
import { Container } from "../../components/ui/container";
import { Heading } from "../../components/ui/heading";
import { Section } from "../../components/ui/section";
import Layout from "../../layouts/Layout.astro";
import { strapi } from "../../lib/strapi";

function localeName(locale: string): null | string {
  switch (locale) {
    case "cs":
      return "Česky";
    case "en":
      return "English";
    default:
      return null;
  }
}

const articles = await strapi.fetchArticles();

const meta = {
  title: "Vojtěch Mareš | Blog",
  description: "Články na méme blogu nejen o DevOps.",
  keywords: "blog, devops blog, články",
};
---

<Layout meta={meta}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse">Blog</Heading>
      <p class="mt-4 text-base text-zinc-100 lg:text-xl">
        <a href="#" class="underline">#kubernetes</a>
        <a href="#" class="underline">#docker</a>
        <a href="#" class="underline">#gitops</a>
        <a href="#" class="underline">#security</a>
      </p>
      <p class="mt-4 text-base text-zinc-100 lg:text-xl">
        <a class="underline" type="application/rss+xml" href="/blog/rss.xml"
          >RSS feed</a
        >
      </p>
    </Container>
  </Section>
  <Section>
    <Container>
      <div
        role="list"
        class="mx-auto flex max-w-2xl flex-col gap-y-16 lg:max-w-4xl"
      >
        {
          articles.map((article) => (
            <Card variant="surface">
              <Heading
                level="h2"
                className="font-display text-3xl font-bold tracking-tight"
              >
                {article.title}
              </Heading>
              <p class="mt-2 mb-4">
                <a href="#" class="underline">
                  #kubernetes
                </a>
                <a href="#" class="underline">
                  #docker
                </a>
                <a href="#" class="underline">
                  #gitops
                </a>
                <a href="#" class="underline">
                  #security
                </a>
              </p>

              <p class="my-4 text-zinc-700">{article.description}</p>
              <div class="flex flex-row justify-end gap-x-6">
                <p class="my-4 text-zinc-700">
                  {new Date(article.publishedAt as Date).toLocaleDateString(
                    "cs-CZ",
                    {
                      day: "numeric",
                      month: "long",
                      year: "numeric",
                    },
                  )}
                  {localeName(article.locale) !== null
                    ? " · " + localeName(article.locale)
                    : ""}
                </p>
                <Button href={"/blog/" + article.slug} variant="primary">
                  Přečíst si článek
                </Button>
              </div>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>
</Layout>
