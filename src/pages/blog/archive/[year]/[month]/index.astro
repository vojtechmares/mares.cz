---
import BlogListing from "../../../../../features/blog/BlogListing.astro";
import Layout from "../../../../../layouts/Layout.astro";
import { t } from "../../../../../i18n";
import { getMonthName, formatArticleCount } from "../../../../../i18n/formatting";
import { localizeUrl } from "../../../../../i18n/routes";
import { getLocalizedCollection } from "../../../../../lib/content";

const locale = Astro.locals.locale;

const { year: yearParam, month: monthParam } = Astro.params;
const year = parseInt(yearParam!);
const month = parseInt(monthParam!);

if (isNaN(year) || isNaN(month) || month < 1 || month > 12) {
  return Astro.redirect("/404", 404);
}

const allArticles = await getLocalizedCollection(
  "blog",
  locale,
  ({ data }) => !data.draft && data.publish_time.getFullYear() === year && data.publish_time.getMonth() + 1 === month,
);

if (allArticles.length === 0) {
  return Astro.redirect("/404", 404);
}

const articles = allArticles.sort((a, b) => b.data.publish_time.valueOf() - a.data.publish_time.valueOf());

const tags = [...new Set(allArticles.flatMap((a) => a.data.tags))];
const monthName = getMonthName(month, locale);

const monthPath = `/blog/archive/${year}/${String(month).padStart(2, "0")}`;

const meta = {
  title: t(locale, "blog.month_meta_title", { month: monthName, year }),
  description: t(locale, "blog.month_meta_description", {
    month: monthName,
    month_lower: monthName.toLowerCase(),
    year,
    count: articles.length,
  }),
  keywords: t(locale, "blog.month_meta_keywords", { month: monthName, year }),
};

const openGraph = {
  type: "website" as const,
  image: {
    url: new URL(localizeUrl(monthPath, locale) + "/card.png", Astro.site).toString(),
    width: 1200,
    height: 630,
    alt: `Blog: ${monthName} ${year}`,
  },
};

const jsonLd = {
  type: "CollectionPage" as const,
  name: `Blog: ${monthName} ${year}`,
  description: meta.description,
  url: new URL(localizeUrl(monthPath, locale), Astro.site).toString(),
};
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <BlogListing
    back
    title={`Blog: ${monthName} ${year}`}
    lead={`${formatArticleCount(articles.length, locale)} ${t(locale, "blog.month_article_suffix")}`}
    articles={articles}
    tags={tags}
    links={[{ label: `← ${year}`, href: localizeUrl(`/blog/archive/${year}`, locale) }]}
  />
</Layout>
