---
import { getCollection } from "astro:content";
import { Container } from "../../../../../components/ui/container";
import { Heading } from "../../../../../components/ui/heading";
import { Section } from "../../../../../components/ui/section";
import { TagList } from "../../../../../components/ui/tag-list";
import Layout from "../../../../../layouts/Layout.astro";
import { ArticleGrid } from "../../../../../features/blog/article-grid";
import { CachePresets } from "../../../../../lib/cache";

const CZECH_MONTHS = [
  "Leden",
  "Únor",
  "Březen",
  "Duben",
  "Květen",
  "Červen",
  "Červenec",
  "Srpen",
  "Září",
  "Říjen",
  "Listopad",
  "Prosinec",
];

const { year: yearParam, month: monthParam } = Astro.params;
const year = parseInt(yearParam!);
const month = parseInt(monthParam!);

if (isNaN(year) || isNaN(month) || month < 1 || month > 12) {
  return Astro.redirect("/404", 404);
}

const allArticles = await getCollection(
  "blog",
  ({ data }) => !data.draft && data.publish_time.getFullYear() === year && data.publish_time.getMonth() + 1 === month,
);

if (allArticles.length === 0) {
  return Astro.redirect("/404", 404);
}

const articles = allArticles.sort((a, b) => b.data.publish_time.valueOf() - a.data.publish_time.valueOf());

const tags = [...new Set(allArticles.flatMap((a) => a.data.tags))];
const monthName = CZECH_MONTHS[month - 1];

Astro.response.headers.set("Cache-Control", CachePresets.archive);

const baseUrl = Astro.url?.toString().replace(/\/$/, "") || "https://www.mares.cz";

const meta = {
  title: `Vojtěch Mareš | Blog: ${monthName} ${year}`,
  description: `Články z ${monthName.toLowerCase()}u ${year} na blogu Vojtěcha Mareše. ${articles.length} článků.`,
  keywords: `blog, devops, ${monthName} ${year}, články`,
};

const openGraph = {
  type: "website" as const,
  image: {
    url: `${baseUrl}/blog/archive/${year}/${String(month).padStart(2, "0")}/card.png`,
    width: 1200,
    height: 630,
    alt: `Blog: ${monthName} ${year}`,
  },
};

const jsonLd = {
  type: "CollectionPage" as const,
  name: `Blog: ${monthName} ${year}`,
  description: meta.description,
  url: `${baseUrl}/blog/archive/${year}/${String(month).padStart(2, "0")}`,
  numberOfItems: articles.length,
};
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse">Blog: {monthName}{" "}{year}</Heading>
      <p class="mt-4 text-base text-zinc-100 lg:text-xl">
        <TagList tags={tags} variant="inverse" />
      </p>
      <p class="mt-4 text-base text-zinc-100 lg:text-xl">
        {articles.length}
        {articles.length === 1 ? "článek" : articles.length < 5 ? "články" : "článků"}
        v tomto měsíci
      </p>
      <p class="mt-2 text-base text-zinc-100 lg:text-xl">
        <a class="underline" href={`/blog/archive/${year}`}>← {year}</a>
        {" · "}
        <a class="underline" href="/blog">Blog</a>
      </p>
    </Container>
  </Section>
  <Section>
    <ArticleGrid articles={articles} />
  </Section>
</Layout>
