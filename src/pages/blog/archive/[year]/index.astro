---
import { Container } from "../../../../components/ui/container";
import { Heading } from "../../../../components/ui/heading";
import { Section } from "../../../../components/ui/section";
import { TagList } from "../../../../components/ui/tag-list";
import Layout from "../../../../layouts/Layout.astro";
import { ArticleGrid } from "../../../../features/blog/article-grid";
import { CachePresets } from "../../../../lib/cache";
import { t } from "../../../../i18n";
import { getMonthName, formatArticleCount } from "../../../../i18n/formatting";
import { localizeUrl } from "../../../../i18n/routes";
import { getLocalizedCollection } from "../../../../lib/content";

const locale = Astro.locals.locale;

const { year: yearParam } = Astro.params;
const year = parseInt(yearParam!);
const currentYear = new Date().getFullYear();

if (isNaN(year) || year < 2020 || year > currentYear + 1) {
  return Astro.redirect("/404", 404);
}

const allArticles = await getLocalizedCollection(
  "blog",
  locale,
  ({ data }) => !data.draft && data.publish_time.getFullYear() === year,
);

if (allArticles.length === 0) {
  return Astro.redirect("/404", 404);
}

const articles = allArticles.sort((a, b) => b.data.publish_time.valueOf() - a.data.publish_time.valueOf());

const monthCounts = new Map<number, number>();
for (const article of allArticles) {
  const month = article.data.publish_time.getMonth() + 1;
  monthCounts.set(month, (monthCounts.get(month) || 0) + 1);
}
const months = Array.from(monthCounts.entries())
  .map(([month, count]) => ({ month, count }))
  .sort((a, b) => b.month - a.month);

const tags = [...new Set(allArticles.flatMap((a) => a.data.tags))];

Astro.response.headers.set("Cache-Control", CachePresets.archive);

const baseUrl = Astro.url?.toString().replace(/\/$/, "") || "https://www.mares.cz";

const meta = {
  title: t(locale, "blog.year_meta_title", { year }),
  description: t(locale, "blog.year_meta_description", { year, count: articles.length }),
  keywords: t(locale, "blog.year_meta_keywords", { year }),
};

const openGraph = {
  type: "website" as const,
  image: {
    url: `${baseUrl}/blog/archive/${year}/card.png`,
    width: 1200,
    height: 630,
    alt: `Blog: ${year}`,
  },
};

const jsonLd = {
  type: "CollectionPage" as const,
  name: `Blog: ${year}`,
  description: meta.description,
  url: `${baseUrl}/blog/archive/${year}`,
};
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse">Blog: {year}</Heading>
      <p class="mt-4 text-base text-zinc-100 lg:text-xl">
        <TagList tags={tags} variant="inverse" />
      </p>
      <div class="flex flex-row justify-between">
        <p class="mt-4 text-base text-zinc-100 lg:text-xl">
          {formatArticleCount(articles.length, locale)}
          {t(locale, "blog.year_article_suffix")}
        </p>
        {
          months.length > 0 &&
            // prettier-ignore
            <p class="mt-2 text-base text-zinc-100 lg:text-xl">{months.map((m, i) => <><a href={localizeUrl(`/blog/archive/${year}/${String(m.month).padStart(2, "0")}`, locale)} class="underline">{getMonthName(m.month, locale)}</a>{i < months.length - 1 ? " · " : ""}</>)}</p>
        }
      </div>
      <p class="mt-2 text-base text-zinc-100 lg:text-xl">
        <a class="underline" href={localizeUrl("/blog", locale)}>{t(locale, "blog.back_to_blog")}</a>
      </p>
    </Container>
  </Section>
  <Section>
    <ArticleGrid articles={articles} locale={locale} />
  </Section>
</Layout>
