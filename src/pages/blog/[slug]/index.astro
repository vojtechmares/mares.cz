---
import { getEntry, render } from "astro:content";
import { TrainingAd } from "../../../features/blog/training-ad";
import Layout from "../../../layouts/Layout.astro";

import "../../../styles/highlight-js/github-dark.css";
import { Section } from "../../../components/ui/section";
import { Container } from "../../../components/ui/container";
import { Heading } from "../../../components/ui/heading";
import { StyleContent } from "../../../components/style-content";
import { TrainingGrid } from "../../../features/training/training-grid";
import { CachePresets } from "../../../lib/cache";

const { slug } = Astro.params;
const article = await getEntry("blog", slug!);
if (!article || article.data.draft) {
  return Astro.redirect("/404", 404);
}

Astro.response.headers.set("Cache-Control", CachePresets.content);

const meta = {
  title: "Vojtěch Mareš | Blog: " + article.data.title,
  description: article.data.description,
  keywords: article.data.keywords.join(","),
};

const openGraph = {
  type: "article" as const,
  image: {
    url: "/blog/" + article.id + "/card.png",
    width: 1200,
    height: 630,
    alt: article.data.title + ": " + article.data.description,
  },
};

const baseUrl = Astro.site?.toString().replace(/\/$/, "") || "https://www.mares.cz";

const jsonLd = {
  type: "BlogPosting" as const,
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publish_time?.toISOString() || new Date().toISOString(),
  dateModified: article.data.publish_time?.toISOString() || new Date().toISOString(),
  author: {
    name: "Vojtěch Mareš",
    url: baseUrl,
  },
  keywords: article.data.keywords.join(","),
  image: baseUrl + "/blog/" + article.id + "/card.png",
  url: baseUrl + "/blog/" + article.id,
};

const { Content } = await render(article);
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse" level="h1">{article.data.title}</Heading>
      <div class="flex flex-row justify-between">
        <p class="mt-4 text-base text-zinc-100 lg:text-xl">{article.data.tags.map((tag) => <><a href={`/blog/tag/${tag}`} class="underline">#{tag}</a>{" "}</>)}</p>
        <p class="mt-4 text-base text-zinc-100 lg:text-xl">
          {
            new Date(article.data.publish_time as Date).toLocaleDateString("cs-CZ", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })
          }
        </p>
      </div>
      <p class="mt-4 text-base text-zinc-100 lg:text-xl">
        <a class="underline" href="/blog">← Zpět na blog</a>
      </p>
    </Container>
  </Section>
  <!-- <ArticleHeader article={article} /> -->
  <Section>
    <StyleContent>
      <article>
        <Content />
      </article>
    </StyleContent>
  </Section>
  {article.data.trainingAd !== undefined && <TrainingAd trainingSlug={article.data.trainingAd as string} />}
  {article.data.trainingAd === undefined && <TrainingGrid />}
</Layout>
