---
import { Debug } from "astro:components";
import { Article } from "../../../features/blog/article";
import { ArticleHeader } from "../../../features/blog/article-header";
import { TrainingAd } from "../../../features/blog/training-ad";
import Layout from "../../../layouts/Layout.astro";
import { strapi } from "../../../lib/strapi";

import "../../../styles/highlight-js/github-dark.css";
import { Section } from "../../../components/ui/section";
import { Container } from "../../../components/ui/container";
import { Heading } from "../../../components/ui/heading";
import { TrainingList } from "../../../features/homepage/training";

const { slug } = Astro.params;

if (slug === undefined) {
  return new Response(null, { status: 404 });
}

const article = await strapi.getArticle(slug);
const trainings = await strapi.fetchTrainings();

const meta = {
  title: "Vojtěch Mareš | Blog: " + article.title,
  description: article.description,
  keywords: article.keywords,
};

const openGraph = {
  type: "article" as const,
  image: {
    url: "/blog/" + article.slug + "/card.png",
    width: 1200,
    height: 630,
    alt: article.title + ": " + article.description,
  },
};

const baseUrl =
  Astro.site?.toString().replace(/\/$/, "") || "https://www.mares.cz";

const jsonLd = {
  type: "BlogPosting" as const,
  headline: article.title,
  description: article.description,
  datePublished: article.publishedAt?.toISOString() || new Date().toISOString(),
  dateModified:
    article.updatedAt?.toISOString() ||
    article.publishedAt?.toISOString() ||
    new Date().toISOString(),
  author: {
    name: "Vojtěch Mareš",
    url: baseUrl,
  },
  keywords: article.keywords,
  image: baseUrl + "/blog/" + article.slug + "/card.png",
  url: baseUrl + "/blog/" + article.slug,
};

function localeName(locale: string): null | string {
  switch (locale) {
    case "cs":
      return "Česky";
    case "en":
      return "English";
    default:
      return null;
  }
}
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse" level="h1">{article.title}</Heading>
      <div class="flex flex-row justify-between">
        <p class="mt-4 text-base text-zinc-100 lg:text-xl">
          <a href="#" class="underline">#kubernetes</a>
          <a href="#" class="underline">#docker</a>
          <a href="#" class="underline">#gitops</a>
          <a href="#" class="underline">#security</a>
        </p>
        <p class="mt-4 text-base text-zinc-100 lg:text-xl">
          {
            new Date(article.publishedAt as Date).toLocaleDateString("cs-CZ", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })
          }
        </p>
      </div>
    </Container>
  </Section>
  <!-- <ArticleHeader article={article} /> -->
  <Section>
    <Article article={article} />
  </Section>
  {
    article.trainingAd !== undefined && (
      <TrainingAd trainingSlug={article.trainingAd} />
    )
  }
  {article.trainingAd === undefined && <TrainingList trainings={trainings} />}
</Layout>
