---
import { getCollection, getEntry, render } from "astro:content";
import { BlogArticleHero } from "../../../features/blog/blog-article-hero";
import { TrainingAd } from "../../../features/blog/training-ad";
import Layout from "../../../layouts/Layout.astro";

import "../../../styles/highlight-js/github-dark.css";
import { Prose } from "../../../components/prose";
import { Section } from "../../../components/ui/section";
import { TrainingGrid } from "../../../features/training/training-grid";
import { CachePresets } from "../../../lib/cache";
import type { Locale } from "../../../i18n";

const locale = (Astro.currentLocale ?? "cs") as Locale;

const { slug } = Astro.params;
const article = await getEntry("blog", slug!);

if (!article || article.data.draft) {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft && data.redirectFrom?.includes(slug!));

  if (allPosts.length > 0) {
    return Astro.redirect(`/blog/${allPosts[0].id}`, 301);
  }
  return Astro.redirect("/404", 404);
}

Astro.response.headers.set("Cache-Control", CachePresets.content);

const meta = {
  title: "Vojtěch Mareš | Blog: " + article.data.title,
  description: article.data.description,
  keywords: article.data.keywords.join(","),
};

const openGraph = {
  type: "article" as const,
  image: {
    url: Astro.url + "/card.png",
    width: 1200,
    height: 630,
    alt: article.data.title + ": " + article.data.description,
  },
};

const baseUrl = Astro.url?.toString().replace(/\/$/, "") || "https://www.mares.cz";

const jsonLd = {
  type: "BlogPosting" as const,
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publish_time?.toISOString() || new Date().toISOString(),
  dateModified: article.data.publish_time?.toISOString() || new Date().toISOString(),
  author: {
    name: "Vojtěch Mareš",
    url: baseUrl,
  },
  keywords: article.data.keywords.join(","),
  image: baseUrl + "/blog/" + article.id + "/card.png",
  url: baseUrl + "/blog/" + article.id,
};

const { Content } = await render(article);

const words = article.body?.split(/\s+/).length ?? 0;
const readingTimeMinutes = Math.max(1, Math.round(words / 200));
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd}>
  <BlogArticleHero
    title={article.data.title}
    description={article.data.description}
    publishDate={article.data.publish_time}
    tags={article.data.tags}
    readingTimeMinutes={readingTimeMinutes}
    locale={locale}
  />
  <!-- <ArticleHeader article={article} /> -->
  <Section>
    <Prose>
      <article>
        <Content />
      </article>
    </Prose>
  </Section>
  {article.data.trainingAd !== undefined && <TrainingAd trainingSlug={article.data.trainingAd as string} locale={locale} />}
  {article.data.trainingAd === undefined && <TrainingGrid locale={locale} />}
</Layout>
