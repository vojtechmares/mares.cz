---
import { render } from "astro:content";
import TrainingAd from "../../../features/blog/TrainingAd.astro";
import CourseRows from "../../../features/shared/CourseRows.astro";
import PostRows from "../../../features/shared/PostRows.astro";
import Portrait from "../../../features/shared/Portrait.astro";
import Toc from "../../../features/shared/Toc.astro";
import Layout from "../../../layouts/Layout.astro";

import { t } from "../../../i18n";
import { formatDate } from "../../../i18n/formatting";
import { getCatalog } from "../../../lib/catalog";
import { getPublishedPosts, readingTimeMinutes, toPostRow } from "../../../lib/posts";
import { getLocalizedEntry, getLocalizedCollection, bareSlug } from "../../../lib/content";
import { localizeUrl } from "../../../i18n/routes";

const locale = Astro.locals.locale;

const { slug } = Astro.params;
const article = await getLocalizedEntry("blog", slug!, locale);

if (!article || article.data.draft) {
  const allPosts = await getLocalizedCollection("blog", locale, ({ data }) => !data.draft && data.redirectFrom?.includes(slug!));

  if (allPosts.length > 0) {
    return Astro.redirect(localizeUrl(`/blog/${bareSlug(allPosts[0].id)}`, locale), 301);
  }
  return Astro.redirect("/404", 404);
}


const meta = {
  title: "Vojtěch Mareš | Blog: " + article.data.title,
  description: article.data.description,
  keywords: article.data.keywords.join(","),
};

const openGraph = {
  type: "article" as const,
  image: {
    url: new URL(localizeUrl("/blog/" + slug, locale) + "/card.png", Astro.site).toString(),
    width: 1200,
    height: 630,
    alt: article.data.title + ": " + article.data.description,
  },
  article: {
    publishedTime: article.data.publish_time?.toISOString(),
    modifiedTime: article.data.publish_time?.toISOString(),
    author: "Vojtěch Mareš",
    tags: article.data.tags,
  },
};

const localizedRoot = new URL(localizeUrl("/", locale), Astro.site).toString().replace(/\/$/, "");

const jsonLd = {
  type: "BlogPosting" as const,
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publish_time?.toISOString() || new Date().toISOString(),
  dateModified: article.data.publish_time?.toISOString() || new Date().toISOString(),
  author: {
    name: "Vojtěch Mareš",
    url: localizedRoot,
  },
  keywords: article.data.keywords.join(","),
  image: new URL(localizeUrl("/blog/" + bareSlug(article.id), locale) + "/card.png", Astro.site).toString(),
  url: new URL(localizeUrl("/blog/" + bareSlug(article.id), locale), Astro.site).toString(),
};

const articleSlug = bareSlug(article.id);
const alternateSlug = article.data.alternate;

let alternateUrls: { cs: string; en: string } | undefined;
if (alternateSlug) {
  if (locale === "cs") {
    alternateUrls = {
      cs: new URL(`/blog/${articleSlug}`, Astro.site).toString(),
      en: new URL(`/en/blog/${alternateSlug}`, Astro.site).toString(),
    };
  } else {
    alternateUrls = {
      cs: new URL(`/blog/${alternateSlug}`, Astro.site).toString(),
      en: new URL(`/en/blog/${articleSlug}`, Astro.site).toString(),
    };
  }
}

const { Content, headings } = await render(article);

const readingTime = readingTimeMinutes(article.body);

// Related reading: newest posts sharing a tag, topped up with the latest ones.
const MORE_COUNT = 4;
const others = (await getPublishedPosts(locale)).filter((post) => post.id !== article.id);
const related = others.filter((post) => post.data.tags.some((tag) => article.data.tags.includes(tag)));
const more = [...new Set([...related, ...others])].slice(0, MORE_COUNT);

const catalog = article.data.trainingAd ? [] : await getCatalog(locale);
---

<Layout meta={meta} openGraph={openGraph} jsonLd={jsonLd} alternateUrls={alternateUrls}>
  <section class="section section--first" style="padding-bottom: 56px">
    <div class="wrap">
      <a href={localizeUrl("/blog", locale)} class="back-link">← {t(locale, "blog.back")}</a>
      <div class="tags" style="margin-bottom: 16px">
        {article.data.tags.map((tag) => <a href={localizeUrl(`/blog/tag/${tag}`, locale)}>#{tag}</a>)}
      </div>
      <h1 class="h-post">{article.data.title}</h1>
      <p class="lead" style="max-width: 760px">{article.data.description}</p>
      <div class="post-meta">
        <time datetime={article.data.publish_time.toISOString()}>{formatDate(article.data.publish_time, locale)}</time>
        <span>{t(locale, "blog.reading_minutes", { count: readingTime })}</span>
        <span>Vojtěch Mareš</span>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap article-grid">
      <Toc headings={headings} title={t(locale, "blog.toc")} />
      <div>
        <article class="prose">
          <Content />
        </article>
        <div class="byline" style="margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--rule); max-width: 760px">
          <Portrait variant="avatar" />
          <span>
            <span class="byline__name">Vojtěch Mareš</span>
            <span class="byline__role">{t(locale, "home.byline_role")}</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  {article.data.trainingAd && <TrainingAd trainingSlug={article.data.trainingAd} />}

  {
    catalog.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">{t(locale, "home.training_eyebrow")}</p>
              <h2 class="h2">{t(locale, "home.training_heading")}</h2>
            </div>
            <a href={localizeUrl("/skoleni", locale)} class="link-arrow">
              {t(locale, "home.training_link")} →
            </a>
          </div>
          <CourseRows courses={catalog} compact />
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">{t(locale, "blog.more_heading")}</h2>
        <a href={localizeUrl("/blog", locale)} class="link-arrow">{t(locale, "home.posts_link")} →</a>
      </div>
      <PostRows posts={more.map((post) => toPostRow(post, locale))} />
    </div>
  </section>
</Layout>
