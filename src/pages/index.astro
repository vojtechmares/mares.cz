---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/homepage/Hero.astro";
import Clients from "../components/homepage/Clients.astro";
import References from "../components/homepage/References.astro";

import {Services} from "../components/homepage/services";
import {TrainingList} from "../components/homepage/training";
import {Cooperation} from "../components/homepage/cooperation";
import {CallToAction} from "../components/homepage/call-to-action";

import {strapi} from "../lib/strapi";
import {dateToLastModified} from "../lib/caching";
const trainings = await strapi.fetchTrainings();

let latest = null;
for (const training of trainings) {
    if (training.updatedAt === null) {
        continue;
    }

    if (latest === null) {
        latest = training.updatedAt;
        continue;
    }

    if (latest > training.updatedAt) {
        continue;
    }

    latest = training.updatedAt;
}

Astro.response.headers.set("Cache-Control", "s-maxage=60, must-revalidate");
if (latest !== null) {
    Astro.response.headers.set("Last-Modified", dateToLastModified(latest));
}
---

<Layout>
    <Hero />
    <Services />
    <Clients />
    <TrainingList trainings={trainings} />
    <References />
    <Cooperation />
    <CallToAction />
</Layout>
