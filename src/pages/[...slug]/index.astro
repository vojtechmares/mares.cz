---
import { getCollection, getEntry, render } from "astro:content";

import { Container } from "../../components/ui/container";
import { Heading } from "../../components/ui/heading";
import { Section } from "../../components/ui/section";
import Layout from "../../layouts/Layout.astro";
import { Prose } from "../../components/prose";
import { CachePresets } from "../../lib/cache";

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/404", 404);
}

const page = await getEntry("page", slug);
if (!page || page.data.draft) {
  const allPages = await getCollection("page", ({ data }) => !data.draft && data.redirectFrom?.includes(slug!));
  if (allPages.length > 0) {
    return Astro.redirect(`/${allPages[0].id}`, 301);
  }
  return Astro.redirect("/404", 404);
}

Astro.response.headers.set("Cache-Control", CachePresets.content);

const meta = {
  title: "Vojtěch Mareš | " + page.data.title,
  description: page.data.description,
  keywords: page.data.keywords.join(","),
};

const openGraph = {
  type: "website" as const,
  image: {
    url: Astro.url + page.id + "/card.png",
    width: 1200,
    height: 630,
    alt: page.data.title + ": " + page.data.description,
  },
};

const { Content } = await render(page);
---

<Layout meta={meta} openGraph={openGraph}>
  <Section variant="inverse">
    <Container>
      <Heading variant="inverse" level="h1">{page.data.title}</Heading>
    </Container>
  </Section>
  <Section>
    <article>
      <Prose>
        <Content />
      </Prose>
    </article>
  </Section>
</Layout>
