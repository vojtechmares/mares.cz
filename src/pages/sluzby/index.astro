---
import { CallToAction } from "../../features/homepage/call-to-action";
import References from "../../features/homepage/References.astro";
import { ServicesConsultation } from "../../features/services/services-consultation";
import { ServicesCooperation } from "../../features/services/services-cooperation";
import { ServicesHero } from "../../features/services/services-hero";
import { ServicesTraining } from "../../features/services/services-training";
import Layout from "../../layouts/Layout.astro";
import { CachePresets } from "../../lib/cache";
import { getCollection } from "astro:content";
import { t, type Locale } from "../../i18n";

const locale = (Astro.currentLocale ?? "cs") as Locale;

Astro.response.headers.set("Cache-Control", CachePresets.content);

const trainings = await getCollection("training", ({ data }) => !data.draft);

const meta = {
  title: t(locale, "services_page.meta_title"),
  description: t(locale, "services_page.meta_description"),
  keywords: t(locale, "services_page.meta_keywords"),
};
---

<Layout
  meta={meta}
  openGraph={{
    type: "website",
    image: {
      url: new URL("/sluzby/card.png", Astro.url).toString(),
      width: 1200,
      height: 630,
      alt: t(locale, "services_page.og_alt"),
    },
  }}
>
  <ServicesHero trainingCount={trainings.length} locale={locale} />

  <ServicesCooperation locale={locale} />

  <ServicesTraining
    locale={locale}
    trainings={trainings.map((t) => ({
      id: t.id,
      title: t.data.title,
      description: t.data.description,
    }))}
  />

  <ServicesConsultation locale={locale} />

  <References />

  <CallToAction locale={locale} />
</Layout>
