---
import { Hero as HeroComponent } from "./hero";
import avatarVojtechMares from "../../images/people/vojtech-mares.png";
import { Picture } from "astro:assets";
---

<HeroComponent>
  <Picture
    class="mx-auto max-w-100 md:mx-0 md:block md:pt-0"
    priority
    loading="eager"
    layout={"full-width"}
    src={avatarVojtechMares}
    alt="Vojtěch Mareš"
    widths={[400, 600, 800]}
    formats={["avif", "webp"]}
    sizes={`(max-width: 768px) 400px, (max-width: 1024px) 600px, 800px`}
  />
</HeroComponent>
