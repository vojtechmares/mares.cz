---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { ReferencesContainer, ReferenceCard } from "./references";
import type { Locale } from "../../i18n";

const locale = (Astro.currentLocale ?? "cs") as Locale;

const images = import.meta.glob<{ default: ImageMetadata }>("/src/images/people/*.{jpg,jpeg,png,webp}", {
  eager: true,
});

const references = (await getCollection("reference", (entry) => !entry.data.draft)).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

const renderedReferences = await Promise.all(
  references.map(async (ref) => {
    const { Content } = await render(ref);
    const imagePath = `/src/images/people/${ref.data.authorImage}`;
    const image = images[imagePath]?.default;
    return { ...ref, Content, image };
  }),
);
---

<ReferencesContainer locale={locale}>
  {
    renderedReferences.map((ref) => (
      <ReferenceCard authorName={ref.data.authorName} authorRole={ref.data.authorRole}>
        <ref.Content slot="content" />
        {ref.image && (
          <Image
            slot="image"
            class="h-14 w-14 rounded-full object-cover"
            src={ref.image}
            alt={ref.data.authorName}
            width={56}
            height={56}
          />
        )}
      </ReferenceCard>
    ))
  }
</ReferencesContainer>
