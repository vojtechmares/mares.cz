---
import { Footer as FooterComponent } from "./footer";
import { LocalizedStaticNavigationLinks } from "../../lib/site";
import { getLocalizedCollection, bareSlug } from "../../lib/content";
import { localizeUrl } from "../../i18n/routes";
import { t } from "../../i18n";

const locale = Astro.locals.locale;

const staticLinks = LocalizedStaticNavigationLinks.filter((links) => {
  return links.locale === locale;
})[0].links as { name: string; href: string }[];

const pages = await getLocalizedCollection("page", locale, ({ data }) => {
  return !data.draft;
});

const trainings = await getLocalizedCollection("training", locale, ({ data }) => {
  return !data.draft;
});

const pageLinks = pages
  .map((page) => {
    return { name: page.data.title, href: localizeUrl(`/${bareSlug(page.id)}`, locale) };
  })
  .filter((link) => {
    return link !== undefined;
  });

const externalLinks = [{ name: t(locale, "footer.devops_wiki"), href: "https://wiki.mares.cz", external: true }];

const links = [...(staticLinks as { name: string; href: string }[]), ...pageLinks, ...externalLinks];
---

<FooterComponent links={links} trainings={trainings} currentYear={new Date().getFullYear()} locale={locale} />
