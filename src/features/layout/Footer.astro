---
import { getCollection } from "astro:content";
import { Footer as FooterComponent } from "./footer";
import { LocalizedStaticNavigationLinks } from "../../lib/site";

let locale = Astro.currentLocale;
if (locale === undefined) {
  locale = "cs";
}

const staticLinks = LocalizedStaticNavigationLinks.filter((links) => {
  return links.locale === locale;
})[0].links as { name: string; href: string }[];

const pages = await getCollection("page", ({ data }) => {
  return !data.draft;
});

const trainings = await getCollection("training", ({ data }) => {
  return !data.draft;
});

const pageLinks = pages
  .map((page) => {
    return { name: page.data.title, href: `/${page.id}` };
  })
  .filter((link) => {
    return link !== undefined;
  });

const links = [...(staticLinks as { name: string; href: string }[]), ...pageLinks];
---

<FooterComponent links={links} trainings={trainings} currentYear={new Date().getFullYear()} />
