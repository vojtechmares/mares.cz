---
import { getCollection } from "astro:content";
import { Navigation as Navbar } from "./navigation";
import { LocalizedStaticNavigationLinks } from "../../lib/site";
import type { Locale } from "../../i18n";

const locale = (Astro.currentLocale ?? "cs") as Locale;

const staticLinks = LocalizedStaticNavigationLinks.filter((links) => {
  return links.locale === locale;
})[0].links;

const pages = await getCollection("page", ({ data }) => {
  return !data.draft && data.featured;
});

const pageLinks = pages
  .map((page) => {
    return { name: page.data.title, href: `/${page.id}` };
  })
  .filter((link) => {
    return link !== undefined;
  });

const links = [...(staticLinks as { name: string; href: string }[]), ...pageLinks];
---

<Navbar links={links} locale={locale} />
