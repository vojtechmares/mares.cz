---
import { canonicalUrl } from "../../../lib/url";

interface Props {
  title?: string;
  prefixedTitle?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
}

let {
  title = undefined,
  prefixedTitle = undefined,
  description = undefined,
  keywords = undefined,
  canonical = undefined,
} = Astro.props;

if (import.meta.env.DEV && description !== undefined) {
  const len = description.length;
  if (len < 90 || len > 160) {
    console.warn(
      `[SEO] Description should be 90–160 characters (got ${len}) on ${Astro.url.pathname}: "${description}"`,
    );
  }
}
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="Vojtěch Mareš" />
<meta name="theme-color" content="#ffffff" />
<link rel="canonical" href={canonical !== undefined ? canonical : canonicalUrl(Astro.url, Astro.site).toString()} />
