---
interface BlogPostSchema {
  type: "BlogPosting";
  headline: string;
  description: string;
  datePublished: string;
  dateModified: string;
  author: {
    name: string;
    url: string;
  };
  keywords: string;
  image?: string;
  url: string;
}

interface WebsiteSchema {
  type: "WebSite" | "Organization" | "Person";
}

interface CollectionPageSchema {
  type: "CollectionPage";
  name: string;
  description: string;
  url: string;
  numberOfItems: number;
}

interface CourseSchema {
  type: "Course";
  name: string;
  description: string;
  provider: {
    name: string;
    url: string;
  };
  offers?: {
    price: number;
    priceCurrency: string;
  };
  hasCourseInstance?: {
    startDate: string;
    endDate?: string;
    courseMode: string;
    location: string;
  }[];
}

interface EventSchema {
  name: string;
  startDate: string;
  endDate?: string;
  location: string;
  organizerName: string;
  organizerUrl: string;
  price: number;
  priceCurrency: string;
  offerUrl?: string;
}

interface ItemListSchema {
  type: "ItemList";
  items: EventSchema[];
}

interface Props {
  schema: BlogPostSchema | WebsiteSchema | CollectionPageSchema | CourseSchema | ItemListSchema;
}

const { schema } = Astro.props;

const baseUrl = Astro.url?.toString().replace(/\/$/, "") || "https://www.mares.cz";

let jsonLd: any;

if (schema.type === "BlogPosting") {
  const blogPost = schema as BlogPostSchema;
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: blogPost.headline,
    description: blogPost.description,
    datePublished: blogPost.datePublished,
    dateModified: blogPost.dateModified,
    author: {
      "@type": "Person",
      name: blogPost.author.name,
      url: blogPost.author.url,
    },
    publisher: {
      "@type": "Person",
      name: "Vojtěch Mareš",
      url: baseUrl,
    },
    keywords: blogPost.keywords,
    ...(blogPost.image && {
      image: {
        "@type": "ImageObject",
        url: blogPost.image,
      },
    }),
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": blogPost.url,
    },
  };
} else if (schema.type === "WebSite") {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Vojtěch Mareš - DevOps architekt",
    url: baseUrl,
    description: "Vojtěch Mareš - DevOps architekt, konzultant a lektor na volné noze",
    author: {
      "@type": "Person",
      name: "Vojtěch Mareš",
      url: baseUrl,
      jobTitle: "DevOps architekt",
      sameAs: [
        "https://github.com/vojtechmares",
        "https://linkedin.com/in/vojtech-mares",
        "https://twitter.com/vojtechmares_",
      ],
    },
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${baseUrl}/blog?q={search_term_string}`,
      },
      "query-input": "required name=search_term_string",
    },
  };
} else if (schema.type === "Organization") {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Vojtěch Mareš",
    url: baseUrl,
    logo: `${baseUrl}/logo.png`,
    sameAs: [
      "https://github.com/vojtechmares",
      "https://linkedin.com/in/vojtech-mares",
      "https://twitter.com/vojtechmares_",
    ],
  };
} else if (schema.type === "Person") {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Vojtěch Mareš",
    url: baseUrl,
    jobTitle: "DevOps architekt",
    description:
      "DevOps architekt, konzultant a lektor na volné noze se zaměřením na Kubernetes, CI/CD a cloud native technologie",
    sameAs: [
      "https://github.com/vojtechmares",
      "https://linkedin.com/in/vojtech-mares",
      "https://twitter.com/vojtechmares_",
    ],
  };
} else if (schema.type === "CollectionPage") {
  const collectionPage = schema as CollectionPageSchema;
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: collectionPage.name,
    description: collectionPage.description,
    url: collectionPage.url,
    numberOfItems: collectionPage.numberOfItems,
    isPartOf: {
      "@type": "WebSite",
      name: "Vojtěch Mareš - DevOps architekt",
      url: baseUrl,
    },
  };
} else if (schema.type === "Course") {
  const course = schema as CourseSchema;
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "Course",
    name: course.name,
    description: course.description,
    provider: {
      "@type": "Person",
      name: course.provider.name,
      url: course.provider.url,
    },
    ...(course.offers && {
      offers: {
        "@type": "Offer",
        price: course.offers.price,
        priceCurrency: course.offers.priceCurrency,
      },
    }),
    ...(course.hasCourseInstance && {
      hasCourseInstance: course.hasCourseInstance.map((instance) => ({
        "@type": "CourseInstance",
        courseMode: instance.courseMode,
        startDate: instance.startDate,
        ...(instance.endDate && { endDate: instance.endDate }),
        location: {
          "@type": "Place",
          name: instance.location,
        },
      })),
    }),
  };
} else if (schema.type === "ItemList") {
  const itemList = schema as ItemListSchema;
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: itemList.items.map((event, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Event",
        name: event.name,
        startDate: event.startDate,
        ...(event.endDate && { endDate: event.endDate }),
        location: {
          "@type": "Place",
          name: event.location,
        },
        organizer: {
          "@type": "Person",
          name: event.organizerName,
          url: event.organizerUrl,
        },
        offers: {
          "@type": "Offer",
          price: event.price,
          priceCurrency: event.priceCurrency,
          ...(event.offerUrl && { url: event.offerUrl }),
          availability: "https://schema.org/InStock",
        },
        eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      },
    })),
  };
}

const jsonLdString = JSON.stringify(jsonLd);
---

<script type="application/ld+json" set:html={jsonLdString} />
