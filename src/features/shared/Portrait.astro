---
import { Image } from "astro:assets";

import portrait from "../../images/people/vojtech-mares.png";
import { t } from "../../i18n";

interface Props {
  /** "frame" is the large hatched portrait, "avatar"/"avatar-lg" the small byline squares. */
  variant?: "frame" | "avatar" | "avatar-lg";
  loading?: "eager" | "lazy";
}

const locale = Astro.locals.locale;
const { variant = "frame", loading = "lazy" } = Astro.props;
---

{
  variant === "frame" ? (
    <div class="portrait hatch">
      <Image src={portrait} alt={t(locale, "home.portrait_label")} width={640} loading={loading} decoding="async" />
    </div>
  ) : (
    <span class:list={["avatar", "avatar--cutout", "hatch", variant === "avatar-lg" && "avatar--lg"]}>
      <Image src={portrait} alt="" width={256} loading={loading} decoding="async" />
    </span>
  )
}
