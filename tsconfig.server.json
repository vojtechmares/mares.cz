{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./dist/server-build",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "types": ["node"],
    "noImplicitAny": false
  },
  "include": ["src/server.ts", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.astro", ".astro"]
}
